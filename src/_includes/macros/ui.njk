{#- Small reusable pieces. Nunjucks macros only see their arguments, so pass data in.
    Partials (src/_includes/partials/) see the whole page context instead. -#}

{#- A section heading block: optional eyebrow, the heading (h2 by default) and a lead paragraph. -#}
{% macro sectionHead(heading, lead="", eyebrow="", id="", level=2, center=false) %}
<div class="section-head{% if center %} section-head--center{% endif %}">
  {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
  <h{{ level }} class="h-section"{% if id %} id="{{ id }}"{% endif %}>{{ heading }}</h{{ level }}>
  {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
</div>
{% endmacro %}
