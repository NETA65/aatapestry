<!doctype html>
{#- The printable poster's layout (/poster/ and /es/poster/): the same page as layouts/base.njk (keep the two
    in step), plus a print page of Letter size with no margins. On paper only #poster prints, as exactly one
    page (src/assets/css/pages/poster.css hides the header, the footer and the screen panel).
    scripts/pdf.mjs declares an A4 @page of its own for the A4 PDF; a later @page rule wins, so keep this one
    an unnamed @page. -#}
<html lang="{{ lang }}" class="poster-page">
<head>
{% include "partials/head.njk" %}
<style media="print">@page { size: letter; margin: 0; }</style>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<a href="#main" class="skip-link">{{ t.nav.skip }}</a>
{% include "partials/header.njk" %}
<main id="main" tabindex="-1">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script src="/assets/js/app.js" defer></script>
</body>
</html>
