{#- Footer: the flyer's purple questions band (the ONE place each page prints the questions address,
    with a copy button), then every page of the site, the resources, the language switch and the
    legal notes. Labels from i18n (t.footer, t.nav, t.contact). -#}
{%- set links = nav[lang] -%}
{%- set email = site.contact.email -%}
<footer>
  {% if email %}
  <section class="questions-band" aria-labelledby="questions-band-label">
    <div class="container-page questions-band-inner">
      {% icon "mail", "icon icon-lg" %}
      <h2 class="questions-band-label" id="questions-band-label">{{ t.contact.body }}</h2>
      <a class="email-link" href="{{ email | mailto(t.contact.subject | tokens) }}">{{ email }}</a>
      <button type="button" class="copy-btn" data-copy="{{ email }}" data-copied="{{ t.labels.copied }}" aria-label="{{ t.contact.copyAddress }}">{% icon "copy", "icon icon-sm" %}<span>{{ t.labels.copy }}</span></button>
    </div>
  </section>
  {% endif %}
  <div class="site-footer on-dark">
    <div class="container-page">
      <div class="footer-grid">
        <div class="footer-about">
          <a href="{{ '/es/' if lang == 'es' else '/' }}" class="brand">
            {% inlineSvg "src/assets/img/logo-plain.svg", "brand-mark" %}
            <span class="brand-name">{{ site.name }}</span>
          </a>
          <p class="mt-4 max-w-sm">{{ t.footer.blurb }}</p>
          <p class="mt-2 max-w-sm">{{ (when.date.longEs | capitalize) if lang == 'es' else when.date.long }} · {{ t.labels.online }}</p>
        </div>
        <nav aria-label="{{ t.nav.footer }}">
          <h2 class="footer-heading">{{ t.footer.workshop }}</h2>
          <ul class="footer-links">
            <li><a href="{{ '/es/' if lang == 'es' else '/' }}">{{ t.nav.home }}</a></li>
            {% for item in links.main %}<li><a href="{{ item.href }}">{{ t.nav[item.key] }}</a></li>{% endfor %}
          </ul>
        </nav>
        <div>
          <h2 class="footer-heading">{{ t.footer.resources }}</h2>
          <ul class="footer-links">
            {% for item in links.resources %}<li><a href="{{ item.href }}"{% if item.download %} download{% endif %}{% if item.lang %} hreflang="{{ item.lang }}"{% endif %}>{{ t.nav[item.key] }}{% if item.lang and item.lang != lang %} <span class="opacity-70">({{ t.labels.englishOnly }})</span>{% endif %}</a></li>{% endfor %}
            <li><a href="{{ page.url | langUrl(otherLang) }}" lang="{{ otherLang }}" hreflang="{{ otherLang }}">{% icon "languages", "icon icon-sm" %}<span>{{ t.switchLabelLong }}</span></a></li>
          </ul>
        </div>
      </div>
      <div class="footer-legal">
        <p>{{ t.footer.disclaimer }}</p>
        {# The full A.A.W.S. reprint credit applies only once the official texts are actually shown. #}
        {% set textsShown = [] %}{% for p in principles.items %}{% if p.step.text or p.tradition.text or p.concept.text %}{% set _ = textsShown.push(p.n) %}{% endif %}{% endfor %}
        <p>{{ t.footer.copyright if textsShown.length else t.footer.copyrightShort }}</p>
        <p>© {% year %} {{ site.contact.committee }}</p>
      </div>
    </div>
  </div>
</footer>
