{%- set items = nav[lang] or nav.en -%}
<footer class="site-footer" x-data="theme">
  <div class="container-page">
    <div class="footer-grid">
      <div>
        <a href="{{ '/es/' if lang == 'es' else '/' }}" class="brand" aria-label="{{ site.name }} — {{ t.nav.home }}">
          {% inlineSvg "brand/logo/mark-plain-mono.svg", "brand-mark" %}
          <span class="brand-name">{{ site.name }}</span>
        </a>
        <p class="mt-3 text-sm text-muted max-w-prose">{{ t.footer.blurb }}</p>
        <p class="mt-3 text-sm text-muted max-w-prose">{{ (when.date.longEs | capitalize) if lang == 'es' else when.date.long }} · {{ when.time.rangeEs if lang == 'es' else when.time.range }} {{ when.tzAbbr }} · {{ t.labels.online }}</p>
      </div>
      <nav aria-label="{{ 'Pie de página' if lang == 'es' else 'Footer' }}">
        <ul class="footer-links">
          {% for item in items %}<li><a href="{{ item.href }}">{{ t.nav[item.key] }}</a></li>{% endfor %}
          {% if lang != 'es' %}<li><a href="/join/">{{ t.nav.join }}</a></li>{% endif %}
          <li><a href="/aatapestry-workshop.ics" download>{% icon "calendar", "icon" %}<span>{{ t.labels.downloadIcs }}</span></a></li>
          <li><a href="/feed.xml">{% icon "rss", "icon" %}<span>{{ copy.updates.feed if lang != 'es' else 'RSS' }}</span></a></li>
          <li><a href="{{ page.url | langUrl(otherLang) }}" lang="{{ otherLang }}" hreflang="{{ otherLang }}">{% icon "languages", "icon" %}<span>{{ t.switchLabel }}</span></a></li>
          {% if site.contact.email %}<li><a href="mailto:{{ site.contact.email }}">{% icon "mail", "icon" %}<span>{{ site.contact.email }}</span></a></li>{% endif %}
        </ul>
      </nav>
      <div class="text-sm text-muted space-y-3">
        <p>{{ t.footer.disclaimer }}</p>
        {# The full A.A.W.S. reprint credit only applies once the official texts are actually shown. #}
        {% set textsShown = [] %}{% for p in principles.items %}{% if p.step.text or p.tradition.text or p.concept.text %}{% set _ = textsShown.push(p.n) %}{% endif %}{% endfor %}
        <p>{{ t.footer.copyright if textsShown.length else t.footer.copyrightShort }}</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="text-xs text-muted">© {% year %} {{ site.contact.committee }}. {{ t.footer.builtWith }} <a href="https://www.11ty.dev/" rel="noopener">Eleventy</a>, <a href="https://tailwindcss.com/" rel="noopener">Tailwind CSS</a>, <a href="https://alpinejs.dev/" rel="noopener">Alpine.js</a>, <a href="https://lucide.dev/" rel="noopener">Lucide</a>, <a href="https://github.com/soldair/node-qrcode" rel="noopener">node-qrcode</a>, <a href="https://add-to-calendar-button.com/" rel="noopener">Add to Calendar Button</a>, <a href="https://fonts.google.com/specimen/Fraunces" rel="noopener">Fraunces</a> &amp; <a href="https://rsms.me/inter/" rel="noopener">Inter</a>.
        {% if build.repoUrl %}<a href="{{ build.repoUrl }}" rel="noopener">{{ 'Código fuente' if lang == 'es' else 'Source code' }}</a> · {% elif site.github.owner %}<a href="https://github.com/{{ site.github.owner }}/{{ site.github.repo }}" rel="noopener">{{ 'Código fuente' if lang == 'es' else 'Source code' }}</a> · {% endif %}
        <span>{{ t.labels.updated }} <time datetime="{{ build.time }}">{{ build.time | date("DDD", lang) }}</time>{% if build.sha %} ({{ build.sha }}){% endif %}</span>
      </p>
      <button type="button" class="btn btn-ghost btn-sm" @click="toggle()">
        <span x-show="!dark">{% icon "moon", "icon" %}</span>
        <span x-show="dark" x-cloak>{% icon "sun", "icon" %}</span>
        <span x-text="dark ? '{{ 'Modo claro' if lang == 'es' else 'Light mode' }}' : '{{ 'Modo oscuro' if lang == 'es' else 'Dark mode' }}'">{{ 'Modo oscuro' if lang == 'es' else 'Dark mode' }}</span>
      </button>
    </div>
  </div>
</footer>
