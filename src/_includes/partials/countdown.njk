{#- A small status pill: "47 days to go" → "Tomorrow" → "Starts in 2 h 10 min" → "Happening now" → ended.
    Rendered by app.js from the labels in i18n (t.countdown); hidden without JavaScript. -#}
{%- set cdLabels = { "days": t.countdown.days, "tomorrow": t.countdown.tomorrow, "today": t.countdown.today, "startsIn": t.countdown.startsIn, "live": t.countdown.live, "ended": t.countdown.ended } -%}
<p class="countdown" data-countdown data-start="{{ when.startISO }}" data-end="{{ when.endISO }}" data-start-label="{{ (when.time.startZoneEs if lang == 'es' else when.time.startZone) | plain }}" data-labels="{{ cdLabels | dump }}" aria-live="polite" hidden><span class="countdown-dot" aria-hidden="true"></span><span data-countdown-text></span></p>
