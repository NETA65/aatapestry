{#- Download buttons for the official flyer (site.flyer: PDF and the 300-dpi JPG), an optional
    "View full size" link to the flyer page, and the printable posters:
      English pages – two buttons: the printer-friendly English poster and the Spanish one;
      Spanish pages – the Spanish poster (the only Spanish printable) as ONE labelled group: view it,
                      PDF letter, PDF A4, PNG.
    Optional before the include: flyerShowView (true: add the "View full size" button). -#}
{%- set fl = site.flyer -%}
{%- set dEs = lang == "es" -%}
{% if fl and fl.pdf %}
<div class="flex flex-wrap gap-3 flyer-downloads">
  <a href="{{ fl.pdf }}" class="btn btn-primary" download="incredible-tapestry-flyer.pdf" type="application/pdf">{% icon "file-down", "icon" %}<span>{{ t.flyer.downloadPdf | tokens }}</span></a>
  {% if fl.jpg %}<a href="{{ fl.jpg }}" class="btn btn-secondary" download="incredible-tapestry-flyer.jpg" type="image/jpeg">{% icon "image", "icon" %}<span>{{ t.flyer.downloadJpg | tokens }}</span></a>{% endif %}
  {% if flyerShowView %}<a href="{{ '/es/flyer/' if dEs else '/flyer/' }}" class="btn btn-secondary">{% icon "maximize-2", "icon" %}<span>{{ t.flyer.viewFull | tokens }}</span></a>{% endif %}
</div>
{% if t.flyer.fileNote %}<p class="text-xs text-muted mt-2">{{ t.flyer.fileNote | tokens }}</p>{% elif fl.pdfSize %}<p class="text-xs text-muted mt-2">PDF · {{ fl.pdfSize }}{% if fl.jpgSize %} · JPG · {{ fl.jpgSize }}{% endif %}</p>{% endif %}
{% endif %}
{% if dEs %}
<p class="flyer-poster-label mt-5" id="poster-es-label">{% icon "printer", "icon" %}<span>{{ t.flyer.posterLabel | tokens }}</span></p>
<div class="flex flex-wrap gap-2 mt-2 flyer-poster-links" role="group" aria-labelledby="poster-es-label">
  <a href="/es/poster/" class="btn btn-secondary btn-sm">{% icon "eye", "icon" %}<span>{{ t.flyer.posterView | tokens }}</span></a>
  <a href="/brand/poster/aatapestry-poster-es-letter.pdf" class="btn btn-secondary btn-sm" download>{% icon "download", "icon" %}<span>{{ t.flyer.posterLetter | tokens }}</span></a>
  <a href="/brand/poster/aatapestry-poster-es-a4.pdf" class="btn btn-secondary btn-sm" download>{% icon "download", "icon" %}<span>{{ t.flyer.posterA4 | tokens }}</span></a>
  <a href="/brand/poster/aatapestry-poster-es.png" class="btn btn-secondary btn-sm" download>{% icon "image", "icon" %}<span>PNG</span></a>
</div>
{% else %}
<div class="flex flex-wrap gap-2 mt-4 flyer-poster-links">
  <a href="/poster/" class="btn btn-secondary btn-sm">{% icon "printer", "icon" %}<span>{{ t.flyer.printerFriendly | tokens }}</span></a>
  <a href="/es/poster/" class="btn btn-secondary btn-sm" lang="es" hreflang="es">{% icon "languages", "icon" %}<span>{{ t.flyer.spanishPoster | tokens }}</span></a>
</div>
{% endif %}
