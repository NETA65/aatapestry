{#- The Zoom details, used on the home page, /join/, /schedule/, /accessibility/ and the Spanish pages.
    All values from site.json / when.js; labels from i18n. Interpretation is listed Spanish first (the
    flyer's order), looked up by key. Optional before the include: zoomHeadingLevel (default 3). -#}
{%- set ev = site.event -%}
<div class="zoom-card card" id="zoom">
  <div class="zoom-card-head">
    <div>
      <p class="eyebrow">{{ t.labels.where }}</p>
      {% set zh = zoomHeadingLevel or 3 %}
      <h{{ zh }} class="h-card">{{ t.labels.online }}</h{{ zh }}>
    </div>
    <span class="badge badge-live" data-live-badge aria-live="polite" hidden>{{ t.countdown.happeningNow }}</span>
  </div>
  <dl class="zoom-dl">
    <div>
      <dt>{{ t.labels.meetingId }}</dt>
      <dd><span class="mono">{{ ev.zoom.meetingId }}</span>
        <button type="button" class="copy-btn" data-copy="{{ ev.zoom.meetingId | digits }}" data-copied="{{ t.labels.copied }}" aria-label="{{ t.labels.copy }}: {{ t.labels.meetingId }}">{% icon "copy", "icon" %}<span>{{ t.labels.copy }}</span></button></dd>
    </div>
    <div>
      <dt>{{ t.labels.passcode }}</dt>
      <dd><span class="mono">{{ ev.zoom.passcode }}</span>
        <button type="button" class="copy-btn" data-copy="{{ ev.zoom.passcode }}" data-copied="{{ t.labels.copied }}" aria-label="{{ t.labels.copy }}: {{ t.labels.passcode }}">{% icon "copy", "icon" %}<span>{{ t.labels.copy }}</span></button></dd>
    </div>
    {% if ev.zoom.dialIn and ev.zoom.dialIn.length %}
    <div>
      <dt>{{ t.labels.dialIn }}</dt>
      <dd>{% for n in ev.zoom.dialIn %}<a href="{{ n | tel }}" class="mono">{{ n }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</dd>
    </div>
    {% endif %}
  </dl>
  <div class="zoom-card-actions">
    <a href="{{ ev.zoom.joinUrl }}" class="btn btn-primary" target="_blank" rel="noopener">{% icon "video", "icon" %}<span>{{ t.labels.joinZoom }}</span><span class="sr-only"> {{ t.a11y.openInNewTab }}</span></a>
    <button type="button" class="btn btn-secondary" data-copy="{{ ev.zoom.joinUrl }}" data-copied="{{ t.labels.copied }}">{% icon "link", "icon" %}<span>{{ t.labels.copyLink }}</span></button>
  </div>
  <ul class="zoom-notes">
    <li>{% icon "clock", "icon" %}<span>{{ (when.date.longEs | capitalize) if lang == 'es' else when.date.long }}&nbsp;· {{ when.time.leadEs if lang == 'es' else when.time.lead }}<br>{{ when.time.startsAlsoEs if lang == 'es' else when.time.startsAlso }}</span></li>
    {% for key in ["es", "asl"] %}{% set i = ev.interpretation | byKey(key) %}{% if i %}<li>{% set iconName = "hand" if key == "asl" else "languages" %}{% icon iconName, "icon" %}<span>{{ i.labelEs if lang == 'es' else i.label }}</span></li>{% endif %}{% endfor %}
    <li>{% icon "info", "icon" %}<span>{{ (t.labels.freeNoRegistration | tokens) or ev.registration.note }}</span></li>
  </ul>
  <p class="text-xs text-muted mt-3">{{ t.labels.lastUpdated }}: <time datetime="{{ ev.zoom.lastUpdated }}">{{ ev.zoom.lastUpdated | date("DDD", lang) }}</time>.</p>
</div>
