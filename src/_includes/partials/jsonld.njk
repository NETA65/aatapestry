{#- Structured data (schema.org JSON-LD), all from site.json / when.js; prose through | tokens.
    Event description: copy.jsonld.eventSummary (EN) or t.landing.metaDescription (ES). FAQPage on "/faq/"
    (q/a) and "/es/faq/" (qEs/aEs), with absolute links. Text through | plain (no no-break spaces or word
    joiners in search-engine data). BreadcrumbList: Home › (36 Principles | the parent page) › this page,
    like the visible breadcrumb; a page under another one names it in front matter (parentCrumb: flyer, a
    pagecopy key); the printable poster sits under the flyer. None on noindex pages (the 404). -#}
{%- set ev = site.event -%}
{%- set evUrl = site.url + ("/es/" if lang == "es" else "/") -%}
{%- set statusMap = { "scheduled": "https://schema.org/EventScheduled", "cancelled": "https://schema.org/EventCancelled", "postponed": "https://schema.org/EventPostponed", "rescheduled": "https://schema.org/EventRescheduled" } -%}
{%- set firstDate = ev.announced or build.date -%}
{%- set org = { "@type": "Organization", "@id": site.url + "/#organization", "name": site.contact.committee, "url": site.url, "logo": { "@type": "ImageObject", "url": ("/brand/favicon/icon-512.png" | absUrl) } } -%}
{%- if site.contact.email %}{% set org = org | merge({ "email": site.contact.email }) %}{% endif -%}
{%- set website = { "@type": "WebSite", "@id": site.url + "/#website", "url": site.url, "name": site.name, "description": (site.description | tokens | plain), "inLanguage": ["en", "es"], "publisher": { "@id": site.url + "/#organization" } } -%}
{%- set graph = [org, website] -%}

{%- if schema == "event" -%}
{%- set eventImages = [ (ogImage | absUrl), ("/brand/social/square.png" | absUrl) ] -%}
{%- if site.flyer and site.flyer.base %}{% set _ = eventImages.push((site.flyer.base + "-1600.jpg") | absUrl) %}{% endif -%}
{%- set eventNode = {
  "@type": "Event",
  "@id": site.url + "/#event",
  "name": ev.name,
  "description": ((t.landing.metaDescription if (lang == "es" and t.landing.metaDescription) else (copy.jsonld.eventSummary if (copy and copy.jsonld and copy.jsonld.eventSummary) else site.description)) | tokens | plain),
  "startDate": when.startISO,
  "endDate": when.endISO,
  "eventStatus": statusMap[ev.status] or statusMap.scheduled,
  "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
  "location": { "@type": "VirtualLocation", "url": ev.zoom.joinUrl, "name": ev.platform },
  "image": eventImages,
  "url": evUrl,
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock", "url": evUrl, "validFrom": firstDate },
  "organizer": { "@id": site.url + "/#organization" },
  "inLanguage": ["en", "es", "ase"],
  "audience": { "@type": "Audience", "audienceType": ((ev.audienceEs if (lang == "es" and ev.audienceEs) else ev.audience) or "A.A. members") },
  "keywords": "Alcoholics Anonymous, Twelve Steps, Twelve Traditions, Twelve Concepts, Three Legacies, workshop, Zoom, ASL interpretation, Spanish interpretation"
} -%}
{%- set _ = graph.push(eventNode) -%}
{%- endif -%}

{%- if (page.url == "/faq/" or page.url == "/es/faq/") and faq and faq.items -%}
{%- set fEs = page.url == "/es/faq/" -%}
{%- set questions = [] -%}
{%- for q in faq.items -%}
{%- set qName = (q.qEs if fEs else q.q) | tokens | plain -%}
{%- set qText = (q.aEs if fEs else q.a) | tokens -%}
{%- if qName and qText %}{% set _ = questions.push({ "@type": "Question", "name": qName, "acceptedAnswer": { "@type": "Answer", "text": (qText | mdInline | plain | replace('href="/', 'href="' + site.url + '/')) } }) %}{% endif -%}
{%- endfor -%}
{%- if questions.length %}{% set _ = graph.push({ "@type": "FAQPage", "@id": (page.url | absUrl) + "#faq", "inLanguage": ("es" if fEs else "en"), "mainEntity": questions }) %}{% endif -%}
{%- endif -%}

{%- if page.url and page.url != "/" and page.url != "/es/" and not noindex -%}
{%- set crumbs = [{ "@type": "ListItem", "position": 1, "name": t.nav.home, "item": (("/es/" if lang == "es" else "/") | absUrl) }] -%}
{%- if page.url != "/principles/" and page.url.startsWith("/principles/") -%}
{%- set _ = crumbs.push({ "@type": "ListItem", "position": 2, "name": t.nav.principles, "item": ("/principles/" | absUrl) }) -%}
{%- endif -%}
{%- set parentKey = parentCrumb or ("flyer" if page.url.endsWith("/poster/") else "") -%}
{%- if parentKey and pagecopy[parentKey] -%}
{%- set _ = crumbs.push({ "@type": "ListItem", "position": crumbs.length + 1, "name": (pagecopy[parentKey][lang].hero.crumb | tokens | plain), "item": ((("/es" if lang == "es" else "") + "/" + parentKey + "/") | absUrl) }) -%}
{%- endif -%}
{%- set _ = crumbs.push({ "@type": "ListItem", "position": crumbs.length + 1, "name": ((title | tokens | plain) or site.name), "item": (page.url | absUrl) }) -%}
{%- set _ = graph.push({ "@type": "BreadcrumbList", "itemListElement": crumbs }) -%}
{%- endif -%}

{%- if schema == "article" and item -%}
{%- set _ = graph.push({ "@type": "Article", "@id": (page.url | absUrl) + "#article", "headline": title, "description": description, "url": (page.url | absUrl), "image": (ogImage | absUrl), "author": { "@id": site.url + "/#organization" }, "publisher": { "@id": site.url + "/#organization" }, "datePublished": firstDate, "dateModified": (page.inputPath | lastmod), "isPartOf": { "@id": site.url + "/#website" }, "about": ["Twelve Steps", "Twelve Traditions", "Twelve Concepts for World Service"], "inLanguage": "en" }) -%}
{%- endif -%}

<script type="application/ld+json">{{ { "@context": "https://schema.org", "@graph": graph } | dump | safe }}</script>
