{#- Site header (the flyer's dark navy; paper with the lighter background on, theme-light.css). Wide screens
    (from 1024 px, when it fits): logo, the menu, the language switch, the lighter-background button and
    the Join button. Narrower (or when the full menu does not fit, app.js → .nav-compact): logo, the
    lighter-background button, Join (from 480 px) and a Menu button that opens the same links plus Contact
    (the footer's questions band) and the language switch. Without JavaScript the Menu control is a link
    to the footer's list of pages (app.js swaps in the button once the menu works) and there is no
    lighter-background button. The Join buttons (.js-event-cta) go away once the workshop has ended
    (main.css). -#}
{%- set items = nav[lang].main -%}
{%- set homeHref = "/es/" if lang == "es" else "/" -%}
{#- The language switch goes to this page's twin; on the English-only pages (the study pages, the 404)
    it goes to the Spanish home page, and the menu's longer label says so. Links to the twin carry
    data-lang-switch: app.js adds the current #section to them (both languages use the same ids). -#}
{%- set switchHref = page.url | langUrl(otherLang) -%}
{%- set switchToHome = otherLang == "es" and switchHref == "/es/" and page.url != "/" -%}
{#- aria-current: "page" on the page itself, "true" on its section (the study pages under 36 Principles). -#}
{%- macro current(href) -%}{% if page.url == href %} aria-current="page"{% elif href != homeHref and page.url.startsWith(href) %} aria-current="true"{% endif %}{%- endmacro -%}
<header class="site-header on-dark">
  <div class="container-page site-header-bar">
    <a href="{{ homeHref }}" class="brand"{% if page.url == homeHref %} aria-current="page"{% endif %}>
      {% inlineSvg "src/assets/img/logo-plain.svg", "brand-mark" %}
      <span class="brand-name">{{ site.name }}</span>
    </a>

    <nav class="nav-desktop" aria-label="{{ t.nav.primary }}">
      <ul class="flex items-center min-[72rem]:gap-0.5">
        {% for item in items %}<li><a href="{{ item.href }}" class="nav-link"{{ current(item.href) }}>{{ t.nav[item.short or item.key] }}</a></li>{% endfor %}
      </ul>
    </nav>

    <div class="nav-actions">
      <a href="{{ switchHref }}" class="nav-link hidden nav:inline-flex" lang="{{ otherLang }}" hreflang="{{ otherLang }}"{% if not switchToHome %} data-lang-switch{% endif %}>{% icon "languages", "icon" %}<span>{{ t.switchLabel }}</span></a>
      {#- The lighter background (theme-light.css): one control, in the bar at every width (not repeated in
          the Menu). app.js keeps aria-pressed current and remembers the choice; hidden without JavaScript. -#}
      <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" title="{{ t.a11y.lighterBackground }}">{% icon "sun", "icon" %}<span class="sr-only">{{ t.a11y.lighterBackground }}</span></button>
      <a href="{{ site.event.zoom.joinUrl }}" class="btn btn-primary btn-sm header-cta js-event-cta" target="_blank" rel="noopener">{% icon "video", "icon" %}<span>{{ t.labels.joinZoom }}</span><span class="sr-only"> {{ t.a11y.openInNewTab }}</span></a>
      {#- The Menu control's name stays "Menu" (aria-expanded says whether it is open; only the icon changes).
          The word shows from 768 px; on phones it is icon-only, so the site name keeps its room. The link
          (no JavaScript) and the button look the same, so swapping them does not move anything. -#}
      <a href="#site-nav-footer" class="menu-toggle" data-menu-fallback>{% icon "menu", "icon" %}<span class="sr-only min-[48rem]:not-sr-only">{{ t.a11y.menu }}</span></a>
      <button type="button" class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="site-menu" hidden>
        {% icon "menu", "icon icon-open" %}{% icon "x", "icon icon-close" %}
        <span class="sr-only min-[48rem]:not-sr-only">{{ t.a11y.menu }}</span>
      </button>
    </div>
  </div>

  <div id="site-menu" class="mobile-menu" hidden>
    <div class="container-page">
      <nav aria-label="{{ t.nav.primary }}">
        <ul>
          <li><a href="{{ homeHref }}" class="nav-link"{% if page.url == homeHref %} aria-current="page"{% endif %}>{{ t.nav.home }}</a></li>
          {% for item in items %}<li><a href="{{ item.href }}" class="nav-link"{{ current(item.href) }}>{{ t.nav[item.key] }}</a></li>{% endfor %}
        </ul>
        <ul class="mobile-menu-extra">
          {#- Contact: the footer's questions band (shown only when there is an address, as in footer.njk). -#}
          {% if site.contact.email %}<li><a href="#questions-band-label" class="nav-link">{% icon "mail", "icon" %}<span>{{ t.nav.contact }}</span></a></li>{% endif %}
          <li class="mobile-menu-lang"><a href="{{ switchHref }}" class="nav-link" lang="{{ otherLang }}" hreflang="{{ otherLang }}"{% if not switchToHome %} data-lang-switch{% endif %}>{% icon "languages", "icon" %}<span>{{ t.switchLabelHome if switchToHome else t.switchLabelLong }}</span></a></li>
        </ul>
      </nav>
      <div class="mobile-menu-actions mobile-menu-cta js-event-cta">
        <a href="{{ site.event.zoom.joinUrl }}" class="btn btn-primary btn-lg btn-block" target="_blank" rel="noopener">{% icon "video", "icon" %}<span>{{ t.labels.joinZoom }}</span><span class="sr-only"> {{ t.a11y.openInNewTab }}</span></a>
      </div>
    </div>
  </div>
</header>
