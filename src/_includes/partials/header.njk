{#- Site header. Desktop: the menu without "Home" (the brand link is home), the language switch and
    the Join button. Phones: everything in the menu. Labels from i18n (t.nav, t.labels). -#}
{%- set items = nav[lang] or nav.en -%}
{%- set homeHref = "/es/" if lang == "es" else "/" -%}
<header class="site-header" x-data="{ open: false }" @keydown.escape.window="open = false">
  <div class="container-page flex items-center gap-3 py-3">
    <a href="{{ homeHref }}" class="brand" aria-label="{{ site.name }} — {{ t.nav.home }}">
      {% inlineSvg "brand/logo/mark-plain.svg", "brand-mark" %}
      <span class="brand-name">{{ site.name }}</span>
    </a>

    <nav class="main-nav" aria-label="{{ 'Principal' if lang == 'es' else 'Primary' }}">
      {% for item in items %}{% if not item.mobileOnly %}
      <a href="{{ item.href }}" class="nav-link{% if page.url == item.href %} is-active{% endif %}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ t.nav[item.key] }}</a>
      {% endif %}{% endfor %}
      <a href="{{ page.url | langUrl(otherLang) }}" class="nav-link nav-lang" lang="{{ otherLang }}" hreflang="{{ otherLang }}">{% icon "languages", "icon" %}<span>{{ t.switchLabel }}</span></a>
      <a href="{{ site.event.zoom.joinUrl }}" class="btn btn-primary btn-sm" target="_blank" rel="noopener">{% icon "video", "icon" %}<span>{{ t.labels.joinZoom }}</span><span class="sr-only"> {{ t.a11y.openInNewTab }}</span></a>
    </nav>

    <button type="button" class="btn btn-ghost btn-sm menu-btn" @click="open = !open" :aria-expanded="open.toString()" aria-expanded="false" aria-controls="mobile-nav">
      <span x-show="!open">{% icon "menu", "icon" %}</span>
      <span x-show="open" x-cloak>{% icon "x", "icon" %}</span>
      <span>{{ t.a11y.menu }}</span>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="{{ 'Principal' if lang == 'es' else 'Primary' }}" x-show="open" x-cloak x-transition.opacity @click.outside="open = false">
    <div class="container-page flex flex-col gap-1 pb-4">
      {% for item in items %}
      <a href="{{ item.href }}" class="nav-link{% if page.url == item.href %} is-active{% endif %}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ t.nav[item.key] }}</a>
      {% endfor %}
      <a href="{{ page.url | langUrl(otherLang) }}" class="nav-link" lang="{{ otherLang }}" hreflang="{{ otherLang }}">{% icon "languages", "icon" %}<span>{{ t.switchLabel }}</span></a>
      <a href="{{ site.event.zoom.joinUrl }}" class="btn btn-primary mt-2" target="_blank" rel="noopener">{% icon "video", "icon" %}<span>{{ t.labels.joinZoom }}</span><span class="sr-only"> {{ t.a11y.openInNewTab }}</span></a>
    </div>
  </nav>
</header>
