{#- Site header (always the flyer's dark navy). Wide screens (from 1024 px): logo, the menu, the language
    switch and the Join button. Narrower: logo, Join (from 480 px) and a Menu button that opens the same links
    (app.js; without JavaScript the menu button is hidden and the footer carries every link). The Join
    buttons (.js-event-cta) go away once the workshop has ended (main.css). -#}
{%- set items = nav[lang].main -%}
{%- set homeHref = "/es/" if lang == "es" else "/" -%}
{#- The language switch goes to this page's twin; on the English-only pages (the study pages, the 404)
    it goes to the Spanish home page, and the menu's longer label says so. -#}
{%- set switchHref = page.url | langUrl(otherLang) -%}
{%- set switchToHome = otherLang == "es" and switchHref == "/es/" and page.url != "/" -%}
{#- aria-current: "page" on the page itself, "true" on its section (the study pages under 36 Principles,
    the printable poster under Flyer). -#}
{%- macro current(href) -%}{% if page.url == href %} aria-current="page"{% elif href != homeHref and page.url.startsWith(href) %} aria-current="true"{% elif href.endsWith("/flyer/") and page.url.endsWith("/poster/") %} aria-current="true"{% endif %}{%- endmacro -%}
<header class="site-header on-dark">
  <div class="container-page site-header-bar">
    <a href="{{ homeHref }}" class="brand"{% if page.url == homeHref %} aria-current="page"{% endif %}>
      {% inlineSvg "src/assets/img/logo-plain.svg", "brand-mark" %}
      <span class="brand-name">{{ site.name }}</span>
    </a>

    <nav class="nav-desktop" aria-label="{{ t.nav.primary }}">
      <ul class="flex items-center min-[72rem]:gap-0.5">
        {% for item in items %}<li><a href="{{ item.href }}" class="nav-link"{{ current(item.href) }}>{{ t.nav[item.key] }}</a></li>{% endfor %}
      </ul>
    </nav>

    <div class="nav-actions">
      <a href="{{ switchHref }}" class="nav-link hidden nav:inline-flex" lang="{{ otherLang }}" hreflang="{{ otherLang }}">{% icon "languages", "icon" %}<span>{{ t.switchLabel }}</span></a>
      <a href="{{ site.event.zoom.joinUrl }}" class="btn btn-primary btn-sm header-cta js-event-cta" target="_blank" rel="noopener">{% icon "video", "icon" %}<span>{{ t.labels.joinZoom }}</span><span class="sr-only"> {{ t.a11y.openInNewTab }}</span></a>
      {#- The button's name stays "Menu" (aria-expanded says whether it is open; only the icon changes).
          The word shows from 768 px; on phones the button is icon-only, so the site name keeps its room. -#}
      <button type="button" class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="site-menu" hidden>
        {% icon "menu", "icon icon-open" %}{% icon "x", "icon icon-close" %}
        <span class="sr-only min-[48rem]:not-sr-only">{{ t.a11y.menu }}</span>
      </button>
    </div>
  </div>

  <div id="site-menu" class="mobile-menu" hidden>
    <div class="container-page">
      <nav aria-label="{{ t.nav.primary }}">
        <ul>
          <li><a href="{{ homeHref }}" class="nav-link"{% if page.url == homeHref %} aria-current="page"{% endif %}>{{ t.nav.home }}</a></li>
          {% for item in items %}<li><a href="{{ item.href }}" class="nav-link"{{ current(item.href) }}>{{ t.nav[item.key] }}</a></li>{% endfor %}
          <li><a href="{{ switchHref }}" class="nav-link" lang="{{ otherLang }}" hreflang="{{ otherLang }}">{% icon "languages", "icon" %}<span>{{ t.switchLabelHome if switchToHome else t.switchLabelLong }}</span></a></li>
        </ul>
      </nav>
      <div class="mobile-menu-actions mobile-menu-cta js-event-cta">
        <a href="{{ site.event.zoom.joinUrl }}" class="btn btn-primary btn-lg btn-block" target="_blank" rel="noopener">{% icon "video", "icon" %}<span>{{ t.labels.joinZoom }}</span><span class="sr-only"> {{ t.a11y.openInNewTab }}</span></a>
      </div>
    </div>
  </div>
</header>
<script>document.querySelector("[data-menu-toggle]").hidden=false</script>
