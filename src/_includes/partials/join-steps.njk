{#- How to join: the changed-Zoom-link notice, steps and tip, Spanish and ASL in Zoom (one card each, looked up by key, Spanish first
    as on the flyer), and Zoom etiquette. ONE source (i18n t.join) for /, /es/, /join/ and /es/join/.
    Optional before the include:
      joinHeadingLevel – default 2; the sub-headings are one level below
      joinPart         – "steps" (heading, steps, tip), "more" (interpretation + etiquette) or "" (all).
                         The home pages include it twice so the Zoom card can sit right after the steps
                         on phones.                                                                       -#}
{%- set jEs = lang == "es" -%}
{%- set jh = joinHeadingLevel or 2 -%}
{%- set jp = joinPart or "" -%}
{% if jp != "more" %}
<h{{ jh }} class="h-section">{{ t.join.heading | tokens }}</h{{ jh }}>
{#- The changed-Zoom-link notice (t.landing.zoomNotice), right under the heading on /, /es/, /join/ and /es/join/. #}
{% if t.landing.zoomNotice %}<p class="panel-muted text-sm mt-4 zoom-notice" role="note">{% icon "info", "icon" %} {{ t.landing.zoomNotice | tokens | mdInline | safe }}</p>{% endif %}
<ol class="steps mt-4">
  {% for s in t.join.steps %}<li><div>{{ s | tokens | mdInline | safe }}</div></li>{% endfor %}
</ol>
{% if t.join.tip %}<p class="mt-6 panel-muted text-sm">{% icon "info", "icon" %} {{ t.join.tip | tokens | mdInline | safe }}</p>{% endif %}
{% endif %}
{% if jp != "steps" %}

<h{{ jh + 1 }} class="h-card{% if jp != 'more' %} mt-8{% endif %}" id="{{ 'interpretacion' if jEs else 'interpretation' }}">{{ t.join.interpretationHeading | tokens }}</h{{ jh + 1 }}>
<div class="interp-cards mt-4">
  {% for key in ["es", "asl"] %}
  {% set i = site.event.interpretation | byKey(key) %}
  {% set paras = t.join.interpretation[key] if t.join.interpretation else [] %}
  {% if i or paras.length %}
  <article class="card">
    <h{{ jh + 2 }} class="h-card">{% set iconName = "hand" if key == "asl" else "languages" %}{% icon iconName, "icon" %} {{ ((i.labelEs if jEs else i.label) if i else key | upper) }}</h{{ jh + 2 }}>
    <div class="prose text-muted mt-2">{% for p in paras %}{{ p | tokens | md | safe }}{% endfor %}</div>
  </article>
  {% endif %}
  {% endfor %}
</div>

<h{{ jh + 1 }} class="h-card mt-8" id="{{ 'etiqueta' if jEs else 'etiquette' }}">{{ t.join.etiquetteHeading | tokens }}</h{{ jh + 1 }}>
<ul class="prose mt-3 list-disc pl-5 text-muted">
  {% for e in t.join.etiquette %}<li>{{ e | tokens | mdInline | safe }}</li>{% endfor %}
</ul>
{% endif %}
