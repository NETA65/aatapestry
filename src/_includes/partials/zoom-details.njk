{#- The Zoom meeting ID and passcode, each with a copy button, then (unless zoomActions is false) the
    Join on Zoom button and Copy link. Values from site.json → event.zoom; labels from i18n.
    Optional before the include: zoomActions (default true), zoomJoinSize ("btn-lg" or "").
    Used on the home page's Zoom card and on /join/. -#}
{%- set z = site.event.zoom -%}
<dl class="kv">
  <div class="kv-row">
    <dt>{{ t.labels.meetingId }}</dt>
    <dd><span class="kv-value">{{ z.meetingId | nbsp }}</span>
      <button type="button" class="copy-btn" data-copy="{{ z.meetingId | digits }}" data-copied="{{ t.labels.copied }}" aria-label="{{ t.labels.copy }}: {{ t.labels.meetingId }}">{% icon "copy", "icon icon-sm" %}<span>{{ t.labels.copy }}</span></button></dd>
  </div>
  <div class="kv-row">
    <dt>{{ t.labels.passcode }}</dt>
    <dd><span class="kv-value">{{ z.passcode }}</span>
      <button type="button" class="copy-btn" data-copy="{{ z.passcode }}" data-copied="{{ t.labels.copied }}" aria-label="{{ t.labels.copy }}: {{ t.labels.passcode }}">{% icon "copy", "icon icon-sm" %}<span>{{ t.labels.copy }}</span></button></dd>
  </div>
  {% if z.dialIn and z.dialIn.length %}
  <div class="kv-row">
    <dt>{{ t.labels.dialIn }}</dt>
    <dd><span>{% for n in z.dialIn %}<a href="{{ n | tel }}" class="kv-value">{{ n }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</span></dd>
  </div>
  {% endif %}
</dl>
{% if zoomActions !== false %}
<div class="btn-row mt-5">
  <a href="{{ z.joinUrl }}" class="btn btn-primary {{ zoomJoinSize }}" target="_blank" rel="noopener">{% icon "video", "icon" %}<span>{{ t.labels.joinZoom }}</span><span class="sr-only"> {{ t.a11y.openInNewTab }}</span></a>
  <button type="button" class="btn btn-outline {{ zoomJoinSize }}" data-copy="{{ z.joinUrl }}" data-copied="{{ t.share.copied }}">{% icon "link", "icon" %}<span>{{ t.labels.copyLink }}</span></button>
</div>
{% endif %}
