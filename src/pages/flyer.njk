---
pagination:
  data: flyerLangs
  size: 1
  alias: plang
  addAllPagesToCollections: true
flyerLangs: ["en", "es"]
permalink: "{% if plang == 'es' %}/es{% endif %}/flyer/"
translated: true
schema: event
eleventyComputed:
  lang: "{{ plang }}"
  title: "{{ i18n[plang].flyer.pageTitle | tokens }}"
  description: "{{ i18n[plang].flyer.pageDescription | tokens }}"
---
{#- The committee's official flyer (English, image-only PDF/JPG from brand/flyer/), its downloads,
    and its full text rendered from data (t.flyer.text + when.js + site.json), so the text never
    disagrees with the Zoom card. The current flyer prints "ET" and the site's own Zoom details; check a
    replacement flyer for both (never "EDT": December is standard time). The address is printed once
    here, in the flyer text. -#}
{% import "macros/ui.njk" as ui %}
{% set ev = site.event %}
{% set fEs = lang == "es" %}
{% set ft = t.flyer.text or {} %}
<section class="section weave-bg">
  <div class="container-page hero" style="padding-block: clamp(2rem, 5vw, 4rem)">
    <p class="eyebrow">{{ (when.date.longEs | capitalize) if fEs else when.date.long }} · <span class="normal-case">{{ when.time.leadEs if fEs else when.time.lead }}</span></p>
    <h1 class="h-display">{{ title }}</h1>
    {% if t.flyer.lead %}<p class="lead">{{ t.flyer.lead | tokens }}</p>{% endif %}
    {% if t.flyer.englishOnly %}<p class="panel-muted text-sm mt-6 max-w-3xl">{% icon "info", "icon" %} {{ t.flyer.englishOnly | tokens }}</p>{% endif %}
  </div>
</section>

<section class="section-tight">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[1fr_22rem] lg:items-start">
      <figure class="flyer-full">
        {% set flyerSizes = "(min-width: 1024px) 30rem, calc(100vw - 2rem)" %}{% set flyerLoading = "eager" %}{% set flyerHref = "" %}{% set flyerDescribedBy = "flyer-text" %}
        {% include "partials/flyer-picture.njk" %}
        {% if t.flyer.figcaption %}<figcaption class="text-sm text-muted mt-3">{{ t.flyer.figcaption | tokens }}</figcaption>{% endif %}
      </figure>

      <aside class="grid gap-6 content-start lg:sticky lg:top-24">
        <div class="card">
          {% set flyerShowView = false %}{% include "partials/flyer-downloads.njk" %}
        </div>
        <div class="card">
          <h2 class="h-card">{% icon "share-2", "icon" %} {{ t.labels.share | tokens }}</h2>
          <div class="mt-3">{% set sharePath = "/es/flyer/" if fEs else "/flyer/" %}{% include "partials/share.njk" %}</div>
        </div>
        {# No questions card here: the flyer text below prints the address (once per page). #}
      </aside>
    </div>
  </div>
</section>

<section class="section" id="flyer-text">
  <div class="container-page">
    <div class="card prose flyer-text max-w-3xl">
      <h2 class="h-section">{{ t.flyer.textHeading | tokens }}</h2>
      {% if ft.overline %}<p class="eyebrow mt-4">{{ ft.overline | tokens }}</p>{% endif %}
      <h3 class="h-section flyer-text-title"{% if fEs %} lang="en"{% endif %}>{{ (ft.title | tokens) or site.name }}</h3>
      {% if ft.subline %}<p class="font-display text-xl italic text-muted">{{ ft.subline | tokens }}</p>{% endif %}
      <p class="when-text mt-4">
        <strong>{{ (when.date.longEs | capitalize) if fEs else when.date.long }}</strong>
        <span class="when-lead">{{ when.time.leadEs if fEs else when.time.lead }}</span>
        <span class="when-also">{{ when.time.startsAlsoEs if fEs else when.time.startsAlso }}</span>
      </p>
      {% if ft.body %}<div class="mt-4">{{ ft.body | tokens | md | safe }}</div>{% endif %}
      {% if ft.strands %}<p class="font-semibold mt-4">{{ ft.strands | tokens }}</p>{% endif %}
      {% if ft.burst %}<p class="font-semibold">{{ ft.burst | tokens }}</p>{% endif %}
      <ul>
        {% for key in ["es", "asl"] %}{% set i = ev.interpretation | byKey(key) %}{% if i %}<li>{{ i.labelEs if fEs else i.label }}</li>{% endif %}{% endfor %}
        {% if ft.costLine %}<li>{{ ft.costLine | tokens }}</li>{% endif %}
        <li>Zoom&nbsp;· {{ t.labels.meetingId | tokens }}: <span class="mono">{{ ev.zoom.meetingId }}</span>&nbsp;· {{ t.labels.passcode | tokens }}: <span class="mono">{{ ev.zoom.passcode }}</span></li>
        <li>{{ (ft.linkLabel | tokens) or "Zoom" }}: <a href="{{ ev.zoom.joinUrl }}" class="email-link" target="_blank" rel="noopener">{{ ev.zoom.joinUrl }}<span class="sr-only"> {{ t.a11y.openInNewTab }}</span></a></li>
      </ul>
      {% if ft.programLine %}<p><a href="{{ '/es/#programa' if fEs else '/schedule/' }}">{{ ft.programLine | tokens }}</a></p>{% endif %}
      {% if ft.websiteLine %}<p>{{ ft.websiteLine | tokens }}</p>{% endif %}
      {% if site.contact.email %}<p>{{ (ft.questionsLine | tokens) or (t.contact.body | tokens) }} <a href="{{ site.contact.email | mailto(t.contact.subject | tokens) }}" class="email-link">{{ site.contact.email }}</a></p>{% endif %}
    </div>
  </div>
</section>
