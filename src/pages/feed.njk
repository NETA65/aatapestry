---
permalink: /feed.xml
eleventyExcludeFromCollections: true
layout: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.name }} — updates</title>
  <subtitle>{{ site.tagline }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <updated>{{ build.time }}</updated>
  <id>{{ site.url }}/</id>
  <author><name>{{ site.contact.committee }}</name>{% if site.contact.email %}<email>{{ site.contact.email }}</email>{% endif %}</author>
  <icon>{{ "/brand/favicon/icon-192.png" | absUrl }}</icon>
  <logo>{{ "/brand/logo/mark-1024.png" | absUrl }}</logo>
  {% for u in updates.items %}
  <entry>
    <title>{{ u.title | tokens | plain }}</title>
    <link href="{{ site.url }}/#updates"/>
    <updated>{{ u.date }}T12:00:00Z</updated>
    <id>tag:{{ site.domain }},{{ u.date }}:{{ u.title | tokens | slugify }}</id>
    {#- Feed readers do not all resolve site-relative links ("/flyer/", "/#join"): make them absolute. #}
    <content type="html">{{ u.body | tokens | md | replace('href="/', 'href="' + site.url + '/') | escape }}</content>
  </entry>
  {% endfor %}
</feed>
