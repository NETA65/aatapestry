---
permalink: /404.html
title: Page not found
noindex: true
eleventyExcludeFromCollections: true
---
<section class="section weave-bg">
  <div class="container-page hero text-center">
    {% inlineSvg "brand/logo/mark-plain-mono.svg", "w-28 h-28 mx-auto opacity-60 mark-mono" %}
    <p class="eyebrow mt-6">404</p>
    <h1 class="h-display">{{ copy.notFound.heading | tokens }}</h1>
    <p class="lead mx-auto">{{ copy.notFound.body | tokens }}</p>
    <div class="hero-actions justify-center">
      <a href="/" class="btn btn-primary">{% icon "arrow-left", "icon" %}<span>{{ copy.notFound.cta | tokens }}</span></a>
      <a href="/join/" class="btn btn-secondary">{% icon "video", "icon" %}<span>{{ t.nav.join }}</span></a>
      <a href="/flyer/" class="btn btn-secondary">{% icon "image", "icon" %}<span>{{ t.nav.flyer }}</span></a>
      <a href="/es/" class="btn btn-ghost" lang="es" hreflang="es">{{ t.switchLabel }}</a>
    </div>
  </div>
</section>
