---
pagination:
  data: joinLangs
  size: 1
  alias: plang
  addAllPagesToCollections: true
joinLangs: ["en", "es"]
permalink: "{% if plang == 'es' %}/es{% endif %}/join/"
translated: true
schema: event
atcb: true
eleventyComputed:
  lang: "{{ plang }}"
  title: "{{ i18n[plang].labels.joinZoom | tokens }}"
  description: "{% if plang == 'es' %}Cómo unirse por Zoom a The Incredible Tapestry ({{ when.date.day }} de {{ when.date.monthEs }}, {{ when.time.leadShortEs }}): enlace, ID, código de acceso e interpretación en español o en ASL.{% else %}How to join The Incredible Tapestry on Zoom ({{ when.date.medium }}, {{ when.time.leadShort }}): link, meeting ID, passcode, and Spanish or ASL interpretation.{% endif %}"
---
{% import "macros/ui.njk" as ui %}
<section class="section weave-bg">
  <div class="container-page hero" style="padding-block: clamp(2rem, 5vw, 4rem)">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">{{ t.landing.eyebrow | tokens }}</p>
        <h1 class="h-display">{{ title }}</h1>
        {% set whenTile = false %}{% set whenClass = "mt-4" %}{% include "partials/when-text.njk" %}
        {#- Add to calendar here too: the changed-Zoom-link notice below asks people to add the workshop again. #}
        <div class="hero-actions">{% set atcbLabel = "" %}{% include "partials/atcb.njk" %}</div>
        {% include "partials/countdown.njk" %}
      </div>
      <div>{% set zoomHeadingLevel = 2 %}{% include "partials/zoom-card.njk" %}</div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container-page">
    {# The changed-Zoom-link notice (t.landing.zoomNotice) is under the How to join heading, in join-steps.njk. #}
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <div>
        {% set joinHeadingLevel = 2 %}{% include "partials/join-steps.njk" %}
      </div>
      <aside class="grid gap-6 content-start lg:sticky lg:top-24">
        {% set qHeadingLevel = 2 %}{% set qSubject = "" %}{% set qId = "questions" %}{% include "partials/questions-card.njk" %}
        <div class="card">
          <h2 class="h-card">{% icon "image", "icon" %} {{ t.flyer.heading | tokens }}</h2>
          {% if t.flyer.lead %}<p class="text-muted mt-1">{{ t.flyer.lead | tokens }}</p>{% endif %}
          {% if t.flyer.englishOnly %}<p class="text-sm text-muted mt-2">{{ t.flyer.englishOnly | tokens }}</p>{% endif %}
          <p class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
            <a href="{{ '/es/flyer/' if lang == 'es' else '/flyer/' }}" class="tap-link">{{ (t.flyer.viewPage or t.flyer.viewFull) | tokens }} {% icon "arrow-right", "icon" %}</a>
            {% if lang == 'es' %}<a href="/es/poster/" class="tap-link">{% icon "printer", "icon" %}<span>{{ t.flyer.spanishPoster | tokens }}</span></a>{% endif %}
          </p>
        </div>
        {% if t.join.accessibilityLink %}<p class="panel-muted text-sm"><a href="/accessibility/{{ '#espanol' if lang == 'es' }}" class="tap-link"{% if lang == 'es' %} hreflang="en"{% endif %}>{% icon "accessibility", "icon" %}<span>{{ t.join.accessibilityLink | tokens }}</span></a></p>{% endif %}
      </aside>
    </div>
  </div>
</section>
