---
layout: layouts/poster.njk
pagination:
  data: posterLangs
  size: 1
  alias: plang
  addAllPagesToCollections: true
posterLangs: ["en", "es"]
permalink: "{% if plang == 'es' %}/es{% endif %}/poster/"
translated: true
titleFonts: true
eleventyComputed:
  lang: "{{ plang }}"
  title: "{{ pagecopy.poster[plang].meta.title | tokens }}"
  description: "{{ pagecopy.poster[plang].meta.description | tokens }}"
---
{#- The printer-friendly poster, /poster/ (English) and /es/poster/ (Spanish, the only Spanish printable):
    on screen, the page hero, a panel to print or download it, and a preview that scales with the screen;
    on paper, only the poster (Letter, one page). The flyer's brand on a light, low-ink background.
    CONTRACT with scripts/pdf.mjs, which renders this page to brand/poster/ (Letter + A4 PDF, 300-dpi PNG):
    keep the element id="poster"; at a 900 px-wide screen it must be exactly 8.5 in (816 px) wide, untransformed
    (the PNG is a screenshot of it); :root[data-size="a4"] switches it to A4 for the A4 PDF.
    Every size inside the poster is in cqw (1% of its width), so the preview, the PDFs and the PNG match.
    The questions address is printed here (print media) as well as in the footer.
    Copy: src/_data/pagecopy/poster.json (c) and i18n (t). Styles: src/assets/css/pages/poster.css. -#}
{% set c = pagecopy.poster[lang] %}
{% set es = lang == "es" %}
{% set p = "/es" if es else "" %}
{% set suffix = "-es" if es else "" %}
{% set z = site.event.zoom %}

{% set hero = { eyebrow: c.hero.eyebrow, title: c.hero.title, lead: c.hero.lead | tokens, crumbs: [{ label: pagecopy.flyer[lang].hero.crumb, href: p + "/flyer/" }], crumbLabel: c.hero.crumb } %}
{% include "partials/page-hero.njk" %}

<section class="section-tight poster-stage">
  <div class="container-page poster-layout">
    <div class="poster-panel">
      <section class="card" aria-labelledby="poster-panel-title">
        <h2 class="h-card" id="poster-panel-title">{{ c.panel.heading }}</h2>
        <button type="button" class="btn btn-primary btn-block mt-4" data-print hidden>{% icon "printer", "icon" %}<span>{{ c.panel.print }}</span></button>
        <script>(function () { var b = document.querySelector("[data-print]"); if (b && window.print) { b.hidden = false; b.addEventListener("click", function () { window.print(); }); } })();</script>
        <ul class="dl-list">
          <li><a class="dl-item" href="/brand/poster/aatapestry-poster{{ suffix }}-letter.pdf" download type="application/pdf">
            <span class="dl-icon">{% icon "file-down", "icon" %}</span>
            <span class="dl-text"><span class="dl-title">{{ c.panel.letter }}</span><span class="dl-meta">{{ c.panel.letterMeta }}</span></span>
            {% icon "download", "icon dl-go" %}</a></li>
          <li><a class="dl-item" href="/brand/poster/aatapestry-poster{{ suffix }}-a4.pdf" download type="application/pdf">
            <span class="dl-icon">{% icon "file-down", "icon" %}</span>
            <span class="dl-text"><span class="dl-title">{{ c.panel.a4 }}</span><span class="dl-meta">{{ c.panel.a4Meta }}</span></span>
            {% icon "download", "icon dl-go" %}</a></li>
          <li><a class="dl-item" href="/brand/poster/aatapestry-poster{{ suffix }}.png" download type="image/png">
            <span class="dl-icon">{% icon "image", "icon" %}</span>
            <span class="dl-text"><span class="dl-title">{{ c.panel.png }}</span><span class="dl-meta">{{ c.panel.pngMeta }}</span></span>
            {% icon "download", "icon dl-go" %}</a></li>
        </ul>
        <p class="poster-tip">{% icon "info", "icon icon-sm" %}<span>{{ c.panel.tip }}</span></p>
      </section>
      <ul class="poster-links">
        <li><a href="{{ '/poster/' if es else '/es/poster/' }}" class="link-arrow" lang="{{ otherLang }}" hreflang="{{ otherLang }}">{% icon "languages", "icon icon-sm" %}<span>{{ c.panel.other }}</span></a></li>
        <li><a href="{{ p }}/flyer/" class="link-arrow">{% icon "file-image", "icon icon-sm" %}<span>{{ c.panel.flyer }}</span></a></li>
      </ul>
    </div>

    <div class="poster-preview">
      <h2 class="eyebrow poster-preview-label" id="poster-preview-title">{{ c.panel.preview }}</h2>

      {# ===== The poster ===== #}
      <div class="poster{% if es %} poster--es{% endif %}" id="poster">
        <div class="poster-weave" aria-hidden="true"></div>
        <div class="poster-inner">
          <div class="poster-head">
            {% inlineSvg "brand/logo/mark.svg", "poster-logo" %}
            <div class="poster-title-wrap">
              <h3 class="poster-title"{% if es %} lang="en"{% endif %}>
                <span class="lockup">
                  <span class="lockup-the poster-gold">{{ c.poster.the }}</span>
                  <span class="lockup-incredible poster-gold">{{ c.poster.incredible }}</span>
                  <span class="lockup-tapestry">{{ c.poster.tapestry }}</span>
                </span>
              </h3>
              {% inlineSvg "src/assets/img/braid.svg", "poster-braid" %}
              {% if t.landing.gloss %}<p class="poster-gloss">{{ t.landing.gloss }}</p>{% endif %}
            </div>
          </div>

          <div class="poster-intro">
            <p class="poster-overline">{{ t.landing.eyebrow }}</p>
            <p class="poster-subline">{{ t.landing.subline }}</p>
          </div>

          <p class="date-ribbon poster-date"><time datetime="{{ when.date.iso }}">{{ (when.date.longEs | capitalize) if es else when.date.long }}</time></p>

          <div class="poster-time">
            <p class="poster-time-main">{{ when.time.leadEs if es else when.time.lead }}</p>
            <div class="poster-time-zones">
              {% for a in when.also %}<p><span>{{ a.startEs if es else a.start }}</span>&nbsp;<b>{{ a.short }}</b></p>{% endfor %}
            </div>
          </div>

          {% set strandIcons = { "recovery": "book-open", "unity": "users", "service": "network" } %}
          {% set strandKeys = { "recovery": "stepsShort", "unity": "traditionsShort", "service": "conceptsShort" } %}
          <ul class="poster-strands">
            {% for l in site.legacies %}
            <li class="poster-strand" data-legacy="{{ l.key }}">
              <span class="poster-strand-icon">{% icon strandIcons[l.key], "icon" %}</span>
              <span><span class="poster-strand-name">{{ t.legacies[strandKeys[l.key]] }}</span><span class="poster-strand-legacy">{{ t.legacies[l.key] }}</span></span>
            </li>
            {% endfor %}
          </ul>

          <div class="poster-zoom">
            <div>
              <p class="poster-zoom-head"><span class="poster-zoom-badge">{% icon "video", "icon" %}</span><span>{{ t.labels.online }}</span></p>
              <dl class="poster-ids">
                <div><dt>{{ t.labels.meetingId }}</dt><dd>{{ z.meetingId | nbsp }}</dd></div>
                <div><dt>{{ t.labels.passcode }}</dt><dd>{{ z.passcode }}</dd></div>
              </dl>
            </div>
            <figure class="poster-qr">{% inlineSvg "brand/qr/qr-zoom.svg", "poster-qr-code" %}<figcaption>{{ c.poster.scanZoom }}</figcaption></figure>
            <figure class="poster-qr">{% inlineSvg "brand/qr/qr-site" + suffix + ".svg", "poster-qr-code" %}<figcaption>{{ c.poster.scanSite }}</figcaption></figure>
          </div>

          <ul class="poster-facts">
            <li class="poster-fact" data-legacy="service"><span class="poster-fact-icon">{% icon "heart-handshake", "icon" %}</span><span><b>{{ t.labels.free }}</b><span>{{ c.poster.freeSub }}</span></span></li>
            <li class="poster-fact" data-legacy="unity"><span class="poster-fact-icon">{% icon "circle-check", "icon" %}</span><span><b>{{ t.labels.noRegistration }}</b><span>{{ c.poster.registrationSub }}</span></span></li>
            <li class="poster-fact" data-legacy="recovery"><span class="poster-fact-icon">{% icon "languages", "icon" %}</span><span><b>{{ c.poster.interpretation }}</b><span>{{ c.poster.interpretationSub }}</span></span></li>
          </ul>

          {% if site.contact.email %}<p class="poster-ask">{% icon "mail", "icon" %}<span>{{ t.contact.body }}</span> <b>{{ site.contact.email }}</b></p>{% endif %}

          <div class="poster-foot">
            <p class="poster-fine">{{ c.poster.fine }}</p>
            <p class="poster-url">{{ site.domain }}{{ "/es" if es }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
