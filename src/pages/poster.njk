---
layout: layouts/poster.njk
pagination:
  data: posterLangs
  size: 1
  alias: plang
  addAllPagesToCollections: true
posterLangs: ["en", "es"]
permalink: "{% if plang == 'es' %}/es{% endif %}/poster/"
translated: true
eleventyComputed:
  lang: "{{ plang }}"
  title: "{{ i18n[plang].poster.pageTitle | tokens }}"
  description: "{{ i18n[plang].poster.pageDescription | tokens }}"
---
{#- The printer-friendly poster (light background, Letter/A4), EN and ES — the ES one is the only Spanish
    printable. scripts/pdf.mjs renders #poster from /poster/ and /es/poster/ to brand/poster/: keep the
    #poster element, the .poster-* classes and the layout. The official flyer lives at /flyer/. -#}
{% set ev = site.event %}
{% set suffix = "-es" if lang == "es" else "" %}
<div class="container-page poster-toolbar no-print">
  <a href="/brand/poster/aatapestry-poster{{ suffix }}-letter.pdf" class="btn btn-primary" download>{% icon "download", "icon" %}<span>PDF · {{ 'Carta' if lang == 'es' else 'Letter' }}</span></a>
  <a href="/brand/poster/aatapestry-poster{{ suffix }}-a4.pdf" class="btn btn-secondary" download>{% icon "download", "icon" %}<span>PDF · A4</span></a>
  <a href="/brand/poster/aatapestry-poster{{ suffix }}.png" class="btn btn-secondary" download>{% icon "image", "icon" %}<span>PNG</span></a>
  <button type="button" class="btn btn-secondary" onclick="window.print()">{% icon "printer", "icon" %}<span>{{ t.labels.print }}</span></button>
  <a href="{{ '/es/flyer/' if lang == 'es' else '/flyer/' }}" class="btn btn-secondary">{% icon "file-image", "icon" %}<span>{{ t.poster.flyerLink | tokens }}</span></a>
  <a href="{{ page.url | langUrl(otherLang) }}" class="btn btn-ghost" lang="{{ otherLang }}" hreflang="{{ otherLang }}">{% icon "languages", "icon" %}<span>{{ t.switchLabel }}</span></a>
</div>

<div class="poster-wrap">
  <div class="poster" id="poster">
    <div class="poster-stripe" aria-hidden="true"></div>
    <div class="poster-bg" aria-hidden="true"></div>
    <div class="poster-inner">
      <header class="poster-top">
        {% inlineSvg "brand/logo/mark.svg", "" %}
        <div>
          <p class="poster-eyebrow">{{ t.landing.eyebrow | tokens }}</p>
          <h1 class="poster-title"{% if lang == 'es' %} lang="en"{% endif %}>{{ (t.poster.headline | tokens) or site.name }}</h1>
          <p class="poster-sub">{{ t.poster.sub | tokens }}</p>
        </div>
      </header>

      <section class="poster-when">
        <div class="poster-date-tile" aria-hidden="true"><span class="m">{{ when.date.monthEs | upper if lang == 'es' else when.date.monthShort }}</span><span class="d">{{ when.date.day }}</span><span class="w">{{ when.date.weekdayEs | capitalize if lang == 'es' else when.date.weekday }}</span></div>
        <div class="poster-when-text">
          <p class="line1">{{ (when.date.longEs | capitalize) if lang == 'es' else when.date.long }}</p>
          {#- Spanish spells the zone out ("hora del Este (ET)") for readers outside the U.S.; it may wrap only after the comma. #}
          <p class="line2">{% if lang == 'es' %}<span class="whitespace-nowrap">{{ when.time.rangeEs }},</span> <span class="whitespace-nowrap">{{ when.tzLabelEs }} ({{ when.tzShort }})</span>{% else %}{{ when.time.lead }}{% endif %}</p>
          <p class="line2b">{{ when.time.startsAlsoEs if lang == 'es' else when.time.startsAlso }}</p>
          <p class="line3">{% for part in ((t.poster.whereLine | tokens) + " · " + (t.poster.freeLine | tokens)).split(" · ") %}<span>{{ part }}</span>{% if not loop.last %}&nbsp;· {% endif %}{% endfor %}</p>
        </div>
      </section>

      <section class="poster-mid">
        <div>
          <div class="poster-legacies">
            {% for l in site.legacies %}
            <div class="poster-legacy" style="--legacy: {{ l.color }}; --legacy-text: {{ l.colorText }}"><i aria-hidden="true"></i><div><b>{{ t.legacies[l.key] }}</b><span>{{ t.legacies[l.shortBody | lower] }}</span></div></div>
            {% endfor %}
          </div>
          <div class="poster-interp">
            <span>{% icon "languages", "icon" %}{% icon "hand", "icon" %}{{ t.poster.interpretationLine | tokens }}</span>
          </div>
        </div>
        <div class="poster-zoom">
          <div class="qr">{% inlineSvg "brand/qr/qr-zoom.svg", "" %}<b>{{ t.poster.scanZoom | tokens }}</b><small>Zoom</small></div>
          {# The Spanish poster's site QR opens the Spanish home page (brand/qr/qr-site-es.svg → /es/). #}
          <div class="qr">{% inlineSvg "brand/qr/qr-site" + suffix + ".svg", "" %}<b>{{ t.poster.scanSite | tokens }}</b><small>{{ site.domain }}{{ "/es" if lang == "es" }}</small></div>
          <div class="ids">
            <div><span>{{ t.poster.meetingId | tokens }}</span><b>{{ ev.zoom.meetingId }}</b></div>
            <div><span>{{ t.poster.passcode | tokens }}</span><b>{{ ev.zoom.passcode }}</b></div>
          </div>
        </div>
      </section>

      <footer class="poster-foot">
        <div>
          <p class="poster-url">{{ site.domain }}</p>
          <p class="poster-free">{{ t.poster.footer | tokens | replace(" · " + site.domain, "") }}</p>
          {% if site.contact.email %}<p class="poster-ask">{{ t.poster.questionsLine | tokens }} <b>{{ site.contact.email }}</b></p>{% endif %}
        </div>
        <p class="poster-fine">{{ t.poster.fine | tokens }}</p>
      </footer>
    </div>
  </div>
</div>

<section class="container-page no-print pb-12">
  <div class="card max-w-3xl mx-auto">
    <h2 class="h-card">{{ t.poster.shareHeading | tokens }}</h2>
    <p class="text-muted mt-2">{{ t.poster.shareBody | tokens }}</p>
    <div class="mt-4">{% include "partials/share.njk" %}</div>
    <p class="text-xs text-muted mt-4">{{ 'Archivos del logotipo y códigos QR en alta resolución:' if lang == 'es' else 'High-resolution logo files and QR codes:' }} <a href="/brand/BRAND.md" class="underline">/brand/</a></p>
  </div>
</section>
