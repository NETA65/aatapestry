---
permalink: /schedule/
atcb: true
eleventyComputed:
  title: "{{ copy.program.pageTitle | tokens }}"
  description: "{{ copy.program.pageDescription | tokens }}"
---
{#- The program page (English only; nav "Program"). Until schedule.json has status "published" and
    sessions, it shows only the announced frame: start, "presentations, sharing and questions — coming
    soon", end. Times lead with Eastern (ET); the zone table gives every US zone, Puerto Rico,
    Mexico City and UTC. -#}
{% import "macros/ui.njk" as ui %}
{% set programPublished = schedule.status == "published" and schedule.sessions and schedule.sessions.length %}
<section class="section">
  <div class="container-page">
    <p class="eyebrow">{{ when.date.long }} · <span class="normal-case">{{ when.time.lead }}</span></p>
    <h1 class="h-display">{{ copy.program.pageHeading | tokens }}</h1>
    {% if copy.program.pageLead %}<p class="lead">{{ copy.program.pageLead | tokens }}</p>{% endif %}
    <div class="mt-5 flex flex-wrap gap-2 items-center">
      {% if not programPublished %}<span class="badge badge-tentative">{% icon "info", "icon" %}{{ t.labels.programSoon | tokens }}</span>{% endif %}
      <span class="badge">{% icon "clock", "icon" %}{{ when.time.lead }}</span>
      <span class="badge">{% icon "video", "icon" %}{{ t.labels.online | tokens }}</span>
      <span class="badge">{% icon "languages", "icon" %}{{ t.labels.interpretationBadge | tokens }}</span>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <div>
        <h2 class="h-section">{{ copy.program.heading | tokens }}</h2>
        {% if copy.program.lead %}<div class="prose text-lg mt-3">{{ copy.program.lead | tokens | md | safe }}</div>{% endif %}
        {% if copy.program.history %}<div class="prose text-muted mt-3">{{ copy.program.history | tokens | md | safe }}</div>{% endif %}
        <p class="strands mt-5">{% for l in site.legacies %}{{ ui.legacyBadge(l, l.shortBody) }}{% endfor %}</p>
        <div class="mt-6">{% set tlHeadingLevel = 3 %}{% set tlLegacyBadges = true %}{% include "partials/program-timeline.njk" %}</div>
        <p class="text-sm text-muted mt-4">{{ copy.program.allTimes | tokens }}</p>
      </div>

      <aside class="grid gap-6">
        <div class="card">
          <h2 class="h-card">{{ t.zones.heading | tokens }}</h2>
          <p class="text-muted text-sm mt-1">{{ t.zones.intro | tokens }}</p>
          <table class="zones mt-3">
            <thead><tr><th scope="col">{{ t.zones.zone | tokens }}</th><th scope="col">{{ t.zones.time | tokens }}</th></tr></thead>
            <tbody>
              {% for z in when.zones %}
              <tr data-zone="{{ z.id }}" class="{% if z.isEvent %}is-event{% endif %}"><td>{{ z.label }}{% if z.abbr != z.label %} ({{ z.abbr }}){% endif %}</td><td>{{ z.range }}{% if z.nextDay %} <small class="text-muted">{{ t.zones.endsNextDay | tokens }}</small>{% endif %}</td></tr>
              {% endfor %}
            </tbody>
          </table>
          <p class="local-time mt-3" data-local-time data-start="{{ when.startISO }}" data-end="{{ when.endISO }}" data-tz="{{ when.zone }}" data-with-date="1" hidden>{{ t.labels.yourLocalTime | tokens }}: <strong data-local-value></strong></p>
        </div>
        <div class="card">
          <h2 class="h-card">{{ t.labels.addToCalendar | tokens }}</h2>
          {% if copy.program.calendarNote %}<p class="text-muted text-sm mt-1 mb-3">{{ copy.program.calendarNote | tokens }}</p>{% endif %}
          {% set atcbLabel = "" %}{% include "partials/atcb.njk" %}
          <a href="/aatapestry-workshop.ics" class="btn btn-secondary btn-sm mt-3" download>{% icon "download", "icon" %}<span>{{ t.labels.downloadIcs | tokens }}</span></a>
        </div>
        {% set zoomHeadingLevel = 2 %}{% include "partials/zoom-card.njk" %}
        {% set qHeadingLevel = 2 %}{% set qSubject = t.contact.subjectProgram %}{% set qId = "questions" %}{% include "partials/questions-card.njk" %}
      </aside>
    </div>
  </div>
</section>
