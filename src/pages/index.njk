---
pagination:
  data: homeLangs
  size: 1
  alias: plang
  addAllPagesToCollections: true
homeLangs: ["en", "es"]
permalink: "{% if plang == 'es' %}/es/{% else %}/{% endif %}"
translated: true
schema: event
titleFonts: true
bodyClass: home
eleventyComputed:
  lang: "{{ plang }}"
  title: "{{ i18n[plang].landing.pageTitle }}"
  description: "{% if plang == 'es' %}{{ i18n.es.landing.metaDescription }}{% endif %}"
---
{#- The home page, / and /es/: the flyer as a web page (logo, title, date, times, Join + Add to calendar),
    then the three things people need (Zoom, interpretation, cost), what the day is, and the flyer to
    share. Every other detail has its own page. Copy: src/_data/pagecopy/home.json (c) and i18n (t). -#}
{% set c = pagecopy.home[lang] %}
{% set es = lang == "es" %}
{% set p = "/es" if es else "" %}

{# ============ HERO: the flyer, as a web page ============ #}
<section class="home-hero thread-bg on-dark">
  <div class="container-page home-hero-inner">
    <p class="home-hero-lang"><a href="{{ page.url | langUrl(otherLang) }}" class="chip" lang="{{ otherLang }}" hreflang="{{ otherLang }}">{% icon "languages", "icon icon-sm" %}<span>{{ c.hero.langPill }}</span></a></p>

    <div class="home-hero-top">
      {% inlineSvg "src/assets/img/logo.svg", "home-hero-logo", c.hero.logoAlt %}
      <h1 class="home-title"{% if es %} lang="en"{% endif %}>
        <span class="lockup">
          <span class="lockup-the gold-text">{{ c.hero.the }}</span>
          <span class="lockup-incredible gold-text">{{ c.hero.incredible }}</span>
          <span class="lockup-tapestry">{{ c.hero.tapestry }}</span>
        </span>
      </h1>
    </div>
    {% if t.landing.gloss %}<p class="home-gloss">{{ t.landing.gloss }}</p>{% endif %}

    {% inlineSvg "src/assets/img/braid.svg", "braid home-braid" %}

    <p class="home-overline">{{ t.landing.eyebrow }}</p>
    <p class="home-subline">{{ t.landing.subline }}</p>

    <p class="date-ribbon home-date"><time datetime="{{ when.date.iso }}">{{ (when.date.longEs | capitalize) if es else when.date.long }}</time></p>

    <div class="home-when">{% include "partials/when-bar.njk" %}</div>

    <div class="btn-row home-actions">
      <a href="{{ site.event.zoom.joinUrl }}" class="btn btn-primary btn-lg" target="_blank" rel="noopener">{% icon "video", "icon" %}<span>{{ t.labels.joinZoom }}</span><span class="sr-only"> {{ t.a11y.openInNewTab }}</span></a>
      {% set calClass = "btn btn-outline btn-lg" %}{% include "partials/calendar-menu.njk" %}
    </div>

    <ul class="chip-row home-chips">
      <li class="chip">{% icon "heart-handshake", "icon icon-sm" %}{{ t.labels.free }}</li>
      <li class="chip">{% icon "circle-check", "icon icon-sm" %}{{ t.labels.noRegistration }}</li>
      <li class="chip">{% icon "languages", "icon icon-sm" %}{{ t.labels.interpretationBadge }}</li>
    </ul>

    {% include "partials/countdown.njk" %}
  </div>
</section>

{# ============ ESSENTIALS: Zoom · interpretation · cost ============ #}
<section class="section" aria-labelledby="essentials-title">
  <div class="container-page">
    <div class="mb-8">{% include "partials/notice.njk" %}</div>
    <h2 class="h-section mb-8" id="essentials-title">{{ c.essentials.heading }}</h2>
    <div class="essentials-grid">
      <article class="card essential essential--zoom" data-legacy="recovery">
        <span class="card-icon">{% icon "video", "icon" %}</span>
        <h3 class="h-card">{{ c.essentials.zoom.title }}</h3>
        <p class="essential-body">{{ c.essentials.zoom.body | tokens | mdInline | safe }}</p>
        {% set zoomActions = false %}{% include "partials/zoom-details.njk" %}
        <a href="{{ p }}/join/" class="link-arrow mt-auto pt-5">{{ c.essentials.zoom.link }}{% icon "arrow-right", "icon icon-sm" %}</a>
      </article>
      <article class="card essential" data-legacy="unity">
        <span class="card-icon">{% icon "languages", "icon" %}</span>
        <h3 class="h-card">{{ c.essentials.interpretation.title }}</h3>
        <p class="essential-body">{{ c.essentials.interpretation.body | tokens | mdInline | safe }}</p>
        <a href="{{ p }}/join/#interpretation" class="link-arrow mt-auto pt-5">{{ c.essentials.interpretation.link }}{% icon "arrow-right", "icon icon-sm" %}</a>
      </article>
      <article class="card essential" data-legacy="service">
        <span class="card-icon">{% icon "heart-handshake", "icon" %}</span>
        <h3 class="h-card">{{ c.essentials.free.title }}</h3>
        <p class="essential-body">{{ c.essentials.free.body | tokens | mdInline | safe }}</p>
        <a href="{{ p }}/faq/#faq-cost" class="link-arrow mt-auto pt-5">{{ c.essentials.free.link }}{% icon "arrow-right", "icon icon-sm" %}</a>
      </article>
    </div>
  </div>
</section>

{# ============ ABOUT THE DAY ============ #}
<section class="section section-alt" aria-labelledby="about-title">
  <div class="container-page about-grid">
    <div>
      <p class="eyebrow">{{ c.about.eyebrow }}</p>
      <h2 class="h-section mt-3" id="about-title">{{ c.about.heading }}</h2>
      <div class="prose lead mt-5">{{ c.about.body | tokens | md | safe }}</div>
      <p class="mt-4 text-muted">{{ c.about.audience | tokens }}</p>
      <div class="btn-row mt-7">
        <a href="{{ p }}/program/" class="btn btn-primary">{% icon "clipboard-list", "icon" %}<span>{{ c.about.programCta }}</span></a>
        <a href="/principles/" class="btn btn-outline"{% if es %} hreflang="en"{% endif %}>{% icon "layers", "icon" %}<span>{{ c.about.principlesCta }}</span></a>
      </div>
      {% if schedule.status != "published" %}<p class="text-sm text-muted mt-3">{{ c.about.programNote }}</p>{% endif %}
    </div>
    <div class="threads">
      <h3 class="sr-only">{{ c.about.threadsLabel }}</h3>
      <ul class="thread-list">
        {% set threadIcons = { "recovery": "book-open", "unity": "users", "service": "network" } %}
        {% set threadKeys = { "recovery": "steps", "unity": "traditions", "service": "concepts" } %}
        {% for l in site.legacies %}
        {% set k = threadKeys[l.key] %}
        <li class="thread" data-legacy="{{ l.key }}">
          <span class="thread-icon">{% icon threadIcons[l.key], "icon" %}</span>
          <div>
            <p class="thread-name">{{ t.legacies[k + "Short"] }} <span class="thread-legacy">· {{ t.legacies[l.key] }}</span></p>
            <p class="thread-text">{{ c.about.threads[k] }}</p>
          </div>
        </li>
        {% endfor %}
      </ul>
      <p class="burst">{{ t.labels.presentations }}!</p>
    </div>
  </div>
</section>

{# ============ THE FLYER + SHARE ============ #}
<section class="section" aria-labelledby="share-title">
  <div class="container-page flyer-band">
    {% set fl = site.flyer %}
    <a href="{{ p }}/flyer/" class="flyer-thumb">
      <picture>
        <source type="image/webp" srcset="{{ fl.base }}-600.webp 600w, {{ fl.base }}-1000.webp 1000w" sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 16rem, 70vw">
        <img src="{{ fl.base }}-600.jpg" srcset="{{ fl.base }}-600.jpg 600w, {{ fl.base }}-1000.jpg 1000w" sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 16rem, 70vw" width="{{ fl.width }}" height="{{ fl.height }}" alt="{{ c.flyer.alt }}" loading="lazy" decoding="async">
      </picture>
    </a>
    <div>
      <h2 class="h-section" id="share-title">{{ c.flyer.heading }}</h2>
      <p class="lead mt-4">{{ c.flyer.body }}</p>
      <div class="btn-row mt-6">
        <a href="{{ fl.pdf }}" class="btn btn-primary" download>{% icon "download", "icon" %}<span>{{ c.flyer.download }}</span></a>
        <a href="{{ p }}/flyer/" class="link-arrow">{{ c.flyer.more }}{% icon "arrow-right", "icon icon-sm" %}</a>
      </div>
      <div class="mt-6">{% set sharePath = "" %}{% include "partials/share.njk" %}</div>
    </div>
  </div>
</section>
