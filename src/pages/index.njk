---
permalink: /
schema: event
atcb: true
translated: true
bodyClass: home
---
{% import "macros/ui.njk" as ui %}
{% set ev = site.event %}

{# ============ HERO ============ #}
<section class="weave-bg">
  <div class="container-page hero">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">{{ copy.hero.eyebrow }}</p>
        <h1 class="h-display">{{ copy.hero.headline }}</h1>
        <p class="lead">{{ copy.hero.sub }}</p>

        <div class="when-line">
          <div class="date-tile" aria-hidden="true"><span class="m">{{ when.date.monthShort }}</span><span class="d">{{ when.date.day }}</span><span class="w">{{ when.date.weekday }}</span></div>
          <p class="when-text">
            <strong>{{ when.date.long }}</strong><br>
            {{ when.time.range }} {{ when.tzAbbr }} ({{ ev.timezoneLabel }})
            <span class="local-time" data-local-time data-start="{{ when.startISO }}" data-end="{{ when.endISO }}" data-tz="{{ when.zone }}" hidden>{{ t.labels.yourLocalTime }}: <span data-local-value></span></span>
          </p>
        </div>

        <div class="hero-badges">
          <span class="badge">{% icon "video", "icon" %}{{ t.labels.online }}</span>
          {% for i in ev.interpretation %}<span class="badge">{% set iconName = "hand" if i.key == "asl" else "languages" %}{% icon iconName, "icon" %}{{ i.label }}</span>{% endfor %}
          <span class="badge">{% icon "heart-handshake", "icon" %}{{ t.labels.free }} · {{ t.labels.noRegistration }}</span>
        </div>

        <div class="hero-actions">
          <a href="{{ ev.zoom.joinUrl }}" class="btn btn-primary btn-lg" target="_blank" rel="noopener">{% icon "video", "icon" %}<span>{{ copy.hero.ctaPrimary }}</span><span class="sr-only"> {{ t.a11y.openInNewTab }}</span></a>
          <add-to-calendar-button
            name="{{ ev.name }}"
            description="{{ site.description }}[br][br]Zoom: [url]{{ ev.zoom.joinUrl }}|Join on Zoom[/url][br]Meeting ID: {{ ev.zoom.meetingId }} · Passcode: {{ ev.zoom.passcode }}[br][br]{{ site.url }}"
            startDate="{{ ev.date }}" startTime="{{ ev.start }}" endDate="{{ ev.date }}" endTime="{{ ev.end }}" timeZone="{{ ev.timezone }}"
            location="{{ ev.zoom.joinUrl }}"
            options="'Apple','Google','iCal','Microsoft365','Outlook.com','Yahoo'"
            iCalFileName="aatapestry-workshop"
            label="{{ copy.hero.ctaSecondary }}"
            buttonStyle="round" lightMode="bodyScheme" listStyle="overlay" language="{{ lang }}" hideBranding="true" hideCheckmark="true" trigger="click"
            styleLight="--btn-background: var(--card); --btn-text: var(--fg); --btn-border: var(--line); --btn-shadow: none; --btn-shadow-hover: none; --font: inherit;" styleDark="--btn-background: var(--card); --btn-text: var(--fg); --btn-border: var(--line); --btn-shadow: none; --btn-shadow-hover: none; --font: inherit;"
          ></add-to-calendar-button>
          <a href="/schedule/" class="btn btn-secondary btn-lg">{% icon "clock", "icon" %}<span>{{ copy.hero.ctaTertiary }}</span></a>
        </div>

        {% include "partials/countdown.njk" %}
      </div>
      <div>
        {% inlineSvg "brand/logo/mark.svg", "hero-mark", site.name + " mark: three triangles, one per legacy, woven into one" %}
      </div>
    </div>
  </div>
</section>

{# ============ FACTS ============ #}
<section class="section-tight" aria-label="At a glance">
  <div class="container-page">
    <dl class="facts card">
      {{ ui.fact("calendar", t.labels.date, when.date.long, when.time.range + " " + when.tzAbbr) }}
      {{ ui.fact("video", t.labels.where, t.labels.online, "Meeting ID " + ev.zoom.meetingId + " · Passcode " + ev.zoom.passcode) }}
      {% set interpLabels = [] %}{% for i in ev.interpretation %}{% set _ = interpLabels.push(i.label) %}{% endfor %}
      {{ ui.fact("languages", t.labels.interpretation, interpLabels | join(" · "), ev.recording) }}
      {{ ui.fact("heart-handshake", t.labels.cost, t.labels.free, ev.registration.note) }}
    </dl>
  </div>
</section>

{# ============ INTRO ============ #}
<section class="section" id="about">
  <div class="container-page">
    {{ ui.sectionHead(copy.intro.heading) }}
    <div class="prose text-lg">
      {% for p in copy.intro.body %}{{ p | md | safe }}{% endfor %}
    </div>
  </div>
</section>

{# ============ THREE LEGACIES ============ #}
<section class="section section-band" id="legacies">
  <div class="container-page">
    {{ ui.sectionHead(copy.legacies.heading, copy.legacies.lead) }}
    <div class="grid-cards">
      {% for l in site.legacies %}{{ ui.legacyCard(l, lang, null, "/principles/#" + l.key) }}{% endfor %}
    </div>
    <p class="lead mt-8">{{ copy.legacies.closing }}</p>
  </div>
</section>

{# ============ 36 THREADS ============ #}
<section class="section" id="thirty-six">
  <div class="container-page">
    {{ ui.sectionHead(copy.thirtySix.heading, copy.thirtySix.lead, site.hook) }}
    <div class="prose mb-8">
      {% for p in copy.thirtySix.body %}{{ p | md | safe }}{% endfor %}
    </div>
    {% if principles and principles.items %}
    <div class="number-grid">
      {% for item in principles.items %}{{ ui.numberTile(item, site.legacies) }}{% endfor %}
    </div>
    {% endif %}
    <div class="mt-8"><a href="/principles/" class="btn btn-primary">{% icon "layers", "icon" %}<span>{{ copy.thirtySix.cta }}</span></a></div>
  </div>
</section>

{# ============ SCHEDULE TEASER ============ #}
<section class="section section-band" id="schedule">
  <div class="container-page">
    {{ ui.sectionHead(copy.schedule.heading, copy.schedule.lead) }}
    {% if schedule.status == "tentative" %}
    <p class="mb-4"><span class="badge badge-tentative">{% icon "info", "icon" %}{{ copy.schedule.tentativeBadge }}</span></p>
    {% endif %}
    <ol class="timeline">
      <li style="--legacy: var(--c-recovery)"><div class="time">{{ when.time.start }}<small>{{ when.tzAbbr }}</small></div><div><h3>{{ (schedule.sessions | first).title if schedule.showSessions else ("Doors open " + when.time.doorsOpen + " · " + (schedule.sessions | first).title) }}</h3><p class="text-muted text-sm">{{ (schedule.sessions | first).summary }}</p></div></li>
      {% if schedule.showSessions %}
        {% for s in schedule.sessions %}{% if not loop.first and not loop.last %}
        {% set lg = s.legacy | legacy %}
        <li class="{% if s.kind == 'break' %}is-break{% endif %}" {% if lg %}style="--legacy: {{ lg.color }}"{% endif %}><div class="time">{{ s.start | time12 }}<small>→ {{ s.end | time12 }}</small></div><div><h3>{{ s.title }}</h3>{% if s.summary %}<p class="text-muted text-sm">{{ s.summary }}</p>{% endif %}</div></li>
        {% endif %}{% endfor %}
      {% else %}
        <li class="is-break"><div class="time">{{ when.lunch.start }}<small>→ {{ when.lunch.end }}</small></div><div><h3>Lunch break ({{ when.lunch.minutes }} min){% if when.lunch.tentative %} · <span class="text-muted">{{ t.labels.tentative | lower }}</span>{% endif %}</h3><p class="text-muted text-sm">{{ copy.schedule.comingSoon }}</p></div></li>
      {% endif %}
      <li style="--legacy: var(--c-service)"><div class="time">{{ when.time.end }}<small>{{ when.tzAbbr }}</small></div><div><h3>{{ (schedule.sessions | last).title if schedule.showSessions else "Close" }}</h3>{% if schedule.showSessions %}<p class="text-muted text-sm">{{ (schedule.sessions | last).summary }}</p>{% endif %}</div></li>
    </ol>
    <p class="text-sm text-muted mt-4">{{ copy.schedule.allTimes }}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/schedule/" class="btn btn-secondary">{% icon "clock", "icon" %}<span>{{ copy.hero.ctaTertiary }}</span></a>
      <a href="/aatapestry-workshop.ics" class="btn btn-secondary" download>{% icon "download", "icon" %}<span>{{ t.labels.downloadIcs }}</span></a>
    </div>
  </div>
</section>

{# ============ HOW TO JOIN + ZOOM ============ #}
<section class="section" id="join">
  <div class="container-page">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-start">
      <div>
        {{ ui.sectionHead(copy.howToJoin.heading) }}
        <ol class="steps">
          {% for s in copy.howToJoin.steps %}<li><div>{{ s | mdInline | safe }}</div></li>{% endfor %}
        </ol>
        <p class="mt-6 panel-muted text-sm">{% icon "info", "icon" %} {{ copy.howToJoin.tip }}</p>
        <h3 class="h-card mt-8">{{ copy.etiquette.heading }}</h3>
        <ul class="prose mt-3 list-disc pl-5 text-muted">
          {% for e in copy.etiquette.items %}<li>{{ e | mdInline | safe }}</li>{% endfor %}
        </ul>
      </div>
      <div class="lg:sticky lg:top-24">
        {% include "partials/zoom-card.njk" %}
      </div>
    </div>
  </div>
</section>

{# ============ ACCESSIBILITY ============ #}
<section class="section section-band" id="accessibility">
  <div class="container-page">
    {{ ui.sectionHead(copy.accessibility.heading, copy.accessibility.lead) }}
    <div class="grid-cards">
      {% for s in copy.accessibility.sections | limit(2) %}
      <article class="card">
        <h3 class="h-card">{% set iconName = "hand" if loop.first else "languages" %}{% icon iconName, "icon" %} {{ s.title }}</h3>
        <div class="prose text-muted mt-2">{{ (s.body | first) | md | safe }}</div>
      </article>
      {% endfor %}
      <article class="card">
        <h3 class="h-card">{% icon "captions", "icon" %} {{ (copy.accessibility.sections | last).title if copy.accessibility.sections.length > 2 else "More" }}</h3>
        <p class="text-muted mt-2">{{ copy.accessibility.requests }}</p>
        <a href="/accessibility/" class="tap-link mt-3">{{ t.nav.accessibility }} {% icon "arrow-right", "icon" %}</a>
      </article>
    </div>
  </div>
</section>

{# ============ MEETING TEASER ============ #}
<section class="section" id="meeting">
  <div class="container-page">
    <div class="card legacy-card" style="--legacy: var(--c-accent, #7c3a8c); --legacy-soft: var(--c-service-soft)">
      <div class="legacy-card-stripe" aria-hidden="true"></div>
      <p class="eyebrow">{{ meeting.name }}</p>
      <h2 class="h-section">{{ copy.meetingTeaser.heading }}</h2>
      <p class="lead">{{ copy.meetingTeaser.body }}</p>
      {% if meeting.published %}
      <p class="mt-3 font-semibold">{{ focus.weekdayLabel }}s · {{ focus.timeLabel }} {{ meeting.timezoneShort }}{% if focus.current and focus.current.n %} · This week: number {{ focus.current.n }}{% endif %}</p>
      <a href="/meeting/" class="btn btn-primary mt-4">{{ copy.meetingTeaser.cta }}</a>
      {% else %}
      <p class="mt-3 text-muted">{{ copy.meetingTeaser.comingSoon }}</p>
      <a href="/principles/" class="btn btn-secondary mt-4">{% icon "layers", "icon" %}<span>{{ copy.thirtySix.cta }}</span></a>
      {% endif %}
    </div>
  </div>
</section>

{# ============ POSTER + SHARE ============ #}
<section class="section section-band" id="share">
  <div class="container-page">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
      <div>
        {{ ui.sectionHead(copy.poster.shareHeading, copy.poster.shareBody) }}
        <div class="flex flex-wrap gap-3">
          <a href="/poster/" class="btn btn-primary">{% icon "image", "icon" %}<span>{{ t.nav.poster }}</span></a>
          <a href="/brand/poster/aatapestry-poster-letter.pdf" class="btn btn-secondary" download>{% icon "download", "icon" %}<span>PDF · Letter</span></a>
          <a href="/brand/poster/aatapestry-poster-a4.pdf" class="btn btn-secondary" download>{% icon "download", "icon" %}<span>PDF · A4</span></a>
          <a href="/brand/poster/aatapestry-poster.png" class="btn btn-secondary" download>{% icon "download", "icon" %}<span>PNG</span></a>
        </div>
        <h3 class="h-card mt-8">{{ copy.share.heading }}</h3>
        <p class="text-muted mt-1 mb-3">{{ copy.share.body }}</p>
        {% include "partials/share.njk" %}
      </div>
      <div class="qr-pair">
        <div class="qr-box">{% inlineSvg "brand/qr/qr-zoom.svg", "", "QR code: " + copy.poster.scanZoom %}<p>{{ copy.poster.scanZoom }}</p></div>
        <div class="qr-box">{% inlineSvg "brand/qr/qr-site.svg", "", "QR code: " + site.url %}<p>{{ copy.poster.scanSite }} · {{ site.domain }}</p></div>
      </div>
    </div>
  </div>
</section>

{# ============ FAQ ============ #}
<section class="section" id="faq">
  <div class="container-page">
    {{ ui.sectionHead("Questions & answers") }}
    <div class="faq max-w-3xl">
      {% for q in faq.items %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ q.q }}</summary>
        <div class="answer prose">{{ q.a | md | safe }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

{# ============ UPDATES + NOTES ============ #}
<section class="section section-band" id="updates">
  <div class="container-page">
    <div class="grid gap-8 lg:grid-cols-3">
      <div>
        <h2 class="h-section">{{ copy.updates.heading }} <a href="/feed.xml" class="text-muted" aria-label="{{ copy.updates.feed }}">{% icon "rss", "icon" %}</a></h2>
        <ul class="updates mt-4">
          {% for u in updates.items | limit(5) %}
          <li><time datetime="{{ u.date }}">{{ u.date | date("DDD") }}</time><h3 class="font-semibold">{{ u.title }}</h3><div class="text-muted text-sm prose">{{ u.body | md | safe }}</div></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h2 class="h-card">{{ copy.anonymity.heading }}</h2>
        <div class="prose text-muted mt-2">{% for p in copy.anonymity.body %}{{ p | md | safe }}{% endfor %}</div>
        <h2 class="h-card mt-6">{{ copy.seventh.heading }}</h2>
        <div class="prose text-muted mt-2">{% for p in copy.seventh.body %}{{ p | md | safe }}{% endfor %}</div>
      </div>
      <div>
        <h2 class="h-card">{{ copy.logoStory.heading }}</h2>
        <div class="flex gap-4 items-start mt-2">
          {% inlineSvg "brand/logo/mark.svg", "w-24 h-24 flex-none" %}
          <div class="prose text-muted">{% for p in copy.logoStory.body %}{{ p | md | safe }}{% endfor %}</div>
        </div>
        {% if site.contact.email or site.contact.formUrl %}
        <h2 class="h-card mt-6">{{ copy.contact.heading }}</h2>
        <p class="text-muted mt-2">{{ copy.contact.body }}</p>
        {% if site.contact.email %}<a href="mailto:{{ site.contact.email }}" class="tap-link mt-2">{% icon "mail", "icon" %} {{ site.contact.email }}</a>{% endif %}
        {% if site.contact.formUrl %}<a href="{{ site.contact.formUrl }}" class="tap-link mt-2" target="_blank" rel="noopener">{% icon "external-link", "icon" %} Contact form</a>{% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</section>
