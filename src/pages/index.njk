---
permalink: /
schema: event
atcb: true
translated: true
bodyClass: home
---
{% import "macros/ui.njk" as ui %}
{% set ev = site.event %}
{% set fl = site.flyer %}
{% set programPublished = schedule.status == "published" and schedule.sessions and schedule.sessions.length %}
{#- Order: practical first (when, how to join, flyer, questions), then the study sections.
    Old anchors kept: #about, #schedule (in #program), #zoom (Zoom card), #share (in #flyer),
    #faq (FAQ list), #accessibility (card in #contribute). Every prose string goes through | tokens. -#}

{# ============ HERO ============ #}
<section class="weave-bg">
  <div class="container-page hero">
    <div class="hero-grid hero-grid--mark">
      <div>
        {% if t.langPill %}<p class="mb-4"><a href="/es/" lang="es" hreflang="es" class="badge lang-pill">{% icon "languages", "icon" %}<span>{{ t.langPill | tokens }}</span></a></p>{% endif %}
        <p class="eyebrow">{{ copy.hero.eyebrow | tokens }}</p>
        <h1 class="h-display">{{ copy.hero.headline | tokens }}</h1>
        {% if site.subtitle %}<p class="font-display text-xl sm:text-2xl italic text-muted mt-2 hero-subline">{{ site.subtitle }}</p>{% endif %}

        {% set whenTile = true %}{% include "partials/when-text.njk" %}

        <div class="hero-actions">
          <a href="{{ ev.zoom.joinUrl }}" class="btn btn-primary btn-lg" target="_blank" rel="noopener">{% icon "video", "icon" %}<span>{{ copy.hero.ctaPrimary | tokens }}</span><span class="sr-only"> {{ t.a11y.openInNewTab }}</span></a>
          {% set atcbLabel = copy.hero.ctaSecondary | tokens %}{% include "partials/atcb.njk" %}
          <a href="/flyer/" class="btn btn-secondary btn-lg">{% icon "image", "icon" %}<span>{{ copy.hero.ctaFlyer | tokens }}</span></a>
        </div>

        <p class="lead hero-lead">{{ copy.hero.sub | tokens }}</p>

        <div class="hero-badges">
          <span class="badge">{% icon "video", "icon" %}{{ t.labels.online | tokens }}</span>
          <span class="badge">{% icon "languages", "icon" %}{{ t.labels.interpretationBadge | tokens }}</span>
          <span class="badge">{% icon "heart-handshake", "icon" %}{{ t.labels.freeNoRegistration | tokens }}</span>
        </div>

        {% include "partials/countdown.njk" %}
      </div>
      <div class="hero-mark-col">
        {% inlineSvg "brand/logo/mark.svg", "hero-mark", (copy.hero.markAlt | tokens) or site.name %}
      </div>
    </div>
  </div>
</section>

{# ============ FACTS ============ #}
<section class="section-tight" id="at-a-glance" aria-label="{{ t.labels.atAGlance | tokens }}">
  <div class="container-page">
    <dl class="facts facts--grid6 card">
      {{ ui.fact("calendar", t.labels.when | tokens, when.date.long, when.time.lead, "", when.time.startsAlso) }}
      {{ ui.fact("video", t.labels.where | tokens, t.labels.online | tokens, (((t.labels.meetingId | tokens) + " " + ev.zoom.meetingId) | nbsp) + " · " + (((t.labels.passcode | tokens) + " " + ev.zoom.passcode) | nbsp)) }}
      {{ ui.fact("languages", t.labels.interpretation | tokens, t.labels.interpretationValue | tokens, t.labels.interpretationSub | tokens, "#interpretation") }}
      {{ ui.fact("heart-handshake", t.labels.cost | tokens, t.labels.freeNoRegistration | tokens, t.labels.contributionsWelcome | tokens) }}
      {% if programPublished %}{{ ui.fact("clipboard-list", t.labels.program | tokens, copy.program.programPageCta | tokens, "", "/schedule/") }}{% else %}{{ ui.fact("clipboard-list", t.labels.program | tokens, t.labels.programSoon | tokens, t.labels.programWillBePosted | tokens, "#program") }}{% endif %}
      {% if site.contact.email %}{{ ui.fact("mail", t.labels.questions | tokens, t.contact.linkText | tokens, "", site.contact.email | mailto(t.contact.subject | tokens)) }}{% endif %}
    </dl>
  </div>
</section>

{# ============ ABOUT THE DAY / PROGRAM ============ #}
<section class="section section-band" id="program">
  <span id="about" class="anchor"></span><span id="schedule" class="anchor"></span>
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-start">
      <div>
        <div class="section-head">
          <h2 class="h-section">{{ copy.program.heading | tokens }}</h2>
          <div class="lead prose">{{ copy.program.lead | tokens | md | safe }}</div>
        </div>
        <div class="prose text-muted">{{ copy.program.history | tokens | md | safe }}</div>
        <p class="strands mt-6">
          {% for l in site.legacies %}{{ ui.legacyBadge(l, l.shortBody) }}{% endfor %}
        </p>
        {% if copy.program.strandsLine %}<p class="text-muted mt-2">{{ copy.program.strandsLine | tokens }}</p>{% endif %}
      </div>
      <div>
        {% include "partials/program-timeline.njk" %}
        <p class="text-sm text-muted mt-4">{{ copy.program.allTimes | tokens }}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/schedule/" class="btn btn-secondary">{% icon "clipboard-list", "icon" %}<span>{{ copy.program.programPageCta | tokens }}</span></a>
          {% set atcbLabel = "" %}{% include "partials/atcb.njk" %}
        </div>
      </div>
    </div>
  </div>
</section>

{# ============ HOW TO JOIN + ZOOM ============ #}
<section class="section" id="join">
  <div class="container-page">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-start">
      <div class="lg:col-start-1 lg:row-start-1">
        {% set joinPart = "steps" %}{% include "partials/join-steps.njk" %}
      </div>
      <div class="lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:sticky lg:top-24">
        {% set zoomHeadingLevel = 3 %}{% include "partials/zoom-card.njk" %}
      </div>
      <div class="lg:col-start-1 lg:row-start-2">
        {% set joinPart = "more" %}{% include "partials/join-steps.njk" %}
      </div>
    </div>
    {% if t.join.accessibilityLink %}<p class="panel-muted text-sm mt-8"><a href="/accessibility/" class="tap-link">{% icon "accessibility", "icon" %}<span>{{ t.join.accessibilityLink | tokens }}</span>{% icon "arrow-right", "icon" %}</a></p>{% endif %}
  </div>
</section>

{# ============ THE OFFICIAL FLYER ============ #}
<section class="section section-band" id="flyer">
  <div class="container-page">
    <div class="grid gap-8 flyer-band">
      <div class="flyer-band-head">
        {{ ui.sectionHead(t.flyer.heading | tokens, t.flyer.lead | tokens) }}
      </div>
      <div class="flyer-band-img">
        {% set flyerSizes = "(min-width: 1024px) 24rem, 20rem" %}{% set flyerLoading = "lazy" %}{% set flyerHref = "/flyer/" %}{% set flyerDescribedBy = "" %}
        {% include "partials/flyer-picture.njk" %}
      </div>
      <div class="flyer-band-body">
        {% set flyerShowView = true %}{% include "partials/flyer-downloads.njk" %}
        <h3 class="h-card mt-8" id="share">{{ copy.share.heading | tokens }}</h3>
        <p class="text-muted mt-1 mb-3">{{ copy.share.body | tokens }}</p>
        {% set sharePath = "" %}{% include "partials/share.njk" %}
      </div>
    </div>
  </div>
</section>

{# ============ QUESTIONS ============ #}
<section class="section" id="questions">
  <div class="container-page">
    <div class="section-head">
      <h2 class="h-section">{{ copy.faq.heading | tokens }}</h2>
      {% if copy.faq.lead %}<div class="lead prose">{{ copy.faq.lead | tokens | mdInline | mailSubject(t.contact.subject | tokens) | safe }}</div>{% endif %}
    </div>
    <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <div class="lg:order-2 lg:sticky lg:top-24">
        {% set qHeadingLevel = 3 %}{% set qSubject = "" %}{% set qId = "" %}{% include "partials/questions-card.njk" %}
      </div>
      <div class="faq" id="faq">
        {% for q in faq.items %}
        <details{% if loop.first %} open{% endif %}{% if q.id %} id="faq-{{ q.id }}"{% endif %}>
          <summary>{{ q.q | tokens }}</summary>
          <div class="answer prose">{{ q.a | tokens | md | mailSubject(t.contact.subject | tokens) | safe }}</div>
        </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# ============ SEVENTH TRADITION · ANONYMITY · ACCESSIBILITY ============ #}
<section class="section section-band" id="contribute">
  <span id="seventh" class="anchor"></span>
  <div class="container-page">
    <div class="grid-cards">
      <article class="card">
        <h2 class="h-card">{% icon "heart-handshake", "icon" %} {{ copy.seventh.heading | tokens }}</h2>
        {% set seventhHtml %}{% for p in copy.seventh.body %}{{ p | tokens | md | safe }}{% endfor %}{% endset %}
        <div class="prose text-muted mt-2">{{ seventhHtml | mailSubject(t.contact.subjectContribution | tokens) | safe }}</div>
        {# The prose normally carries {email} (a mailto link with the contributions subject); if not, add one. #}
        {% if site.contact.email and not (site.contact.email in seventhHtml) %}<a href="{{ site.contact.email | mailto(t.contact.subjectContribution | tokens) }}" class="tap-link mt-3 email-link">{% icon "mail", "icon" %}<span>{{ t.contact.linkText | tokens }}</span></a>{% endif %}
      </article>
      <article class="card">
        <h2 class="h-card">{% icon "users", "icon" %} {{ copy.anonymity.heading | tokens }}</h2>
        <div class="prose text-muted mt-2">{% for p in copy.anonymity.body %}{{ p | tokens | md | safe }}{% endfor %}</div>
      </article>
      <article class="card" id="accessibility">
        <h2 class="h-card">{% icon "accessibility", "icon" %} {{ copy.accessibility.heading | tokens }}</h2>
        <p class="text-muted mt-2">{{ copy.accessibility.teaser | tokens }}</p>
        <a href="/accessibility/" class="tap-link mt-3">{{ t.nav.accessibility | tokens }} {% icon "arrow-right", "icon" %}</a>
      </article>
    </div>
  </div>
</section>

{# ============ THREE LEGACIES ============ #}
<section class="section" id="legacies">
  <div class="container-page">
    {% if copy.intro and copy.intro.heading %}
    <div class="section-head"><h2 class="h-section">{{ copy.intro.heading | tokens }}</h2></div>
    <div class="prose text-lg mb-10">
      {% for p in copy.intro.body %}{{ p | tokens | md | safe }}{% endfor %}
    </div>
    {% endif %}
    {{ ui.sectionHead(copy.legacies.heading | tokens, copy.legacies.lead | tokens) }}
    <div class="grid-cards">
      {% for l in site.legacies %}{{ ui.legacyCard(l, lang, null, "/principles/#" + l.key) }}{% endfor %}
    </div>
    <p class="lead mt-8">{{ copy.legacies.closing | tokens }}</p>
  </div>
</section>

{# ============ 36 THREADS ============ #}
<section class="section section-band" id="thirty-six">
  <div class="container-page">
    {{ ui.sectionHead(copy.thirtySix.heading | tokens, copy.thirtySix.lead | tokens, site.hook) }}
    <div class="prose mb-8">
      {% for p in copy.thirtySix.body %}{{ p | tokens | md | safe }}{% endfor %}
    </div>
    {% if principles and principles.items %}
    <div class="number-grid">
      {% for item in principles.items %}{{ ui.numberTile(item, site.legacies) }}{% endfor %}
    </div>
    {% endif %}
    <div class="mt-8"><a href="/principles/" class="btn btn-primary">{% icon "layers", "icon" %}<span>{{ copy.thirtySix.cta | tokens }}</span></a></div>
  </div>
</section>

{# ============ WEEKLY MEETING (only once meeting.json is published) ============ #}
{% if meeting.published %}
<section class="section" id="meeting">
  <div class="container-page">
    <div class="card legacy-card" style="--legacy: var(--c-accent, #7c3a8c); --legacy-soft: var(--c-service-soft)">
      <div class="legacy-card-stripe" aria-hidden="true"></div>
      <p class="eyebrow">{{ meeting.name }}</p>
      <h2 class="h-section">{{ copy.meetingTeaser.heading | tokens }}</h2>
      <p class="lead">{{ copy.meetingTeaser.body | tokens }}</p>
      {% if focus.configured %}<p class="mt-3 font-semibold">{{ focus.weekdayLabel }}s · {{ focus.timeLabel }} {{ meeting.timezoneShort }}{% if focus.current and focus.current.n %} · This week: number {{ focus.current.n }}{% endif %}</p>{% endif %}
      <a href="/meeting/" class="btn btn-primary mt-4">{{ copy.meetingTeaser.cta | tokens }}</a>
    </div>
  </div>
</section>
{% endif %}

{# ============ UPDATES + ABOUT THE MARK ============ #}
<section class="section" id="updates">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="h-section">{{ copy.updates.heading | tokens }} <a href="/feed.xml" class="text-muted" aria-label="{{ copy.updates.feed | tokens }}">{% icon "rss", "icon" %}</a></h2>
        <ul class="updates mt-4">
          {% for u in updates.items | limit(5) %}
          <li><time datetime="{{ u.date }}">{{ u.date | date("DDD") }}</time><h3 class="font-semibold">{{ u.title | tokens }}</h3><div class="text-muted text-sm prose">{{ u.body | tokens | md | mailSubject(t.contact.subject | tokens) | safe }}</div></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h2 class="h-card">{{ copy.logoStory.heading | tokens }}</h2>
        <div class="flex gap-4 items-start mt-2">
          {% inlineSvg "brand/logo/mark.svg", "w-24 h-24 flex-none mark-disc" %}
          <div class="prose text-muted">{% for p in copy.logoStory.body %}{{ p | tokens | md | safe }}{% endfor %}</div>
        </div>
      </div>
    </div>
  </div>
</section>
