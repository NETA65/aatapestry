---
permalink: /es/
lang: es
translated: true
schema: event
atcb: true
eleventyComputed:
  title: "{{ i18n.es.landing.pageTitle | tokens }}"
  description: "{{ i18n.es.landing.metaDescription | tokens }}"
---
{% import "macros/ui.njk" as ui %}
{% set ev = site.event %}
{% set L = t.landing %}
{% set programPublished = schedule.status == "published" and schedule.sessions and schedule.sessions.length %}
{#- Spanish landing page: the same facts as "/", interpretation first. All prose from i18n.es
    (t.landing, t.join, t.flyer, t.contact …) and faq.json (qEs/aEs), through | tokens. -#}

{# ============ HERO ============ #}
<section class="weave-bg">
  <div class="container-page hero">
    <div class="hero-grid hero-grid--mark">
      <div>
        {% if t.langPill %}<p class="mb-4"><a href="/" lang="en" hreflang="en" class="badge lang-pill">{% icon "languages", "icon" %}<span>{{ t.langPill | tokens }}</span></a></p>{% endif %}
        <p class="eyebrow">{{ L.eyebrow | tokens }}</p>
        <h1 class="h-display" lang="en">{{ (L.headline | tokens) or site.name }}</h1>
        {% if L.gloss %}<p class="font-display text-2xl italic text-muted mt-2 hero-subline">{{ L.gloss | tokens }}</p>{% endif %}
        {% if L.subline %}<p class="font-display text-lg sm:text-xl italic text-muted mt-2" style="text-wrap: balance">{{ L.subline | tokens }}</p>{% endif %}

        {% set whenTile = true %}{% include "partials/when-text.njk" %}

        <div class="hero-actions">
          <a href="{{ ev.zoom.joinUrl }}" class="btn btn-primary btn-lg" target="_blank" rel="noopener">{% icon "video", "icon" %}<span>{{ t.labels.joinZoom | tokens }}</span><span class="sr-only"> {{ t.a11y.openInNewTab }}</span></a>
          {% set atcbLabel = "" %}{% include "partials/atcb.njk" %}
          <a href="/es/flyer/" class="btn btn-secondary btn-lg">{% icon "image", "icon" %}<span>{{ t.flyer.heading | tokens }}</span></a>
        </div>

        <p class="lead hero-lead">{{ L.sub | tokens }}</p>

        <div class="hero-badges">
          <span class="badge">{% icon "languages", "icon" %}{{ t.labels.interpretationBadge | tokens }}</span>
          <span class="badge">{% icon "video", "icon" %}{{ t.labels.online | tokens }}</span>
          <span class="badge">{% icon "heart-handshake", "icon" %}{{ t.labels.freeNoRegistration | tokens }}</span>
        </div>

        {% include "partials/countdown.njk" %}
      </div>
      <div class="hero-mark-col">{% inlineSvg "brand/logo/mark.svg", "hero-mark" %}</div>
    </div>
  </div>
</section>

{# ============ DATOS ============ #}
<section class="section-tight" id="datos" aria-label="{{ t.labels.atAGlance | tokens }}">
  <div class="container-page">
    <dl class="facts facts--grid6 card">
      {{ ui.fact("calendar", t.labels.when | tokens, when.date.longEs | capitalize, when.time.leadEs, "", when.time.startsAlsoEs) }}
      {{ ui.fact("video", t.labels.where | tokens, t.labels.online | tokens, (((t.labels.meetingId | tokens) + " " + ev.zoom.meetingId) | nbsp) + " · " + (((t.labels.passcode | tokens) + " " + ev.zoom.passcode) | nbsp)) }}
      {{ ui.fact("languages", t.labels.interpretation | tokens, t.labels.interpretationValue | tokens, t.labels.interpretationSub | tokens, "#interpretacion") }}
      {{ ui.fact("heart-handshake", t.labels.cost | tokens, t.labels.freeNoRegistration | tokens, t.labels.contributionsWelcome | tokens) }}
      {% if programPublished %}{{ ui.fact("clipboard-list", t.labels.program | tokens, t.labels.seeProgram | tokens, "", "#programa") }}{% else %}{{ ui.fact("clipboard-list", t.labels.program | tokens, t.labels.programSoon | tokens, t.labels.programWillBePosted | tokens, "#programa") }}{% endif %}
      {% if site.contact.email %}{{ ui.fact("mail", t.labels.questions | tokens, t.contact.linkText | tokens, "", site.contact.email | mailto(t.contact.subject | tokens)) }}{% endif %}
    </dl>
  </div>
</section>

{# ============ PROGRAMA ============ #}
<section class="section section-band" id="programa">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-start">
      <div>
        <div class="section-head">
          <h2 class="h-section">{{ L.programHeading | tokens }}</h2>
          <div class="lead prose">{{ L.programLead | tokens | md | safe }}</div>
        </div>
        <div class="prose text-muted">{{ L.programHistory | tokens | md | safe }}</div>
        <p class="strands mt-6">
          {% for l in site.legacies %}{{ ui.legacyBadge(l, t.legacies[l.shortBody | lower]) }}{% endfor %}
        </p>
        {% if L.strandsLine %}<p class="text-muted mt-2">{{ L.strandsLine | tokens }}</p>{% endif %}
      </div>
      <div>
        {% include "partials/program-timeline.njk" %}
        {% if t.zones.allTimes %}<p class="text-sm text-muted mt-4">{{ t.zones.allTimes | tokens }}</p>{% endif %}
        <div class="mt-6 flex flex-wrap gap-3">
          {% set atcbLabel = "" %}{% include "partials/atcb.njk" %}
        </div>
      </div>
    </div>
  </div>
</section>

{# ============ CÓMO UNIRSE ============ #}
<section class="section" id="unirse">
  <div class="container-page">
    {# The changed-Zoom-link notice (L.zoomNotice) is under the "Cómo unirse" heading, in join-steps.njk. #}
    <div class="grid gap-8 lg:grid-cols-2 lg:items-start">
      <div class="lg:col-start-1 lg:row-start-1">
        {% set joinHeadingLevel = 2 %}{% set joinPart = "steps" %}{% include "partials/join-steps.njk" %}
      </div>
      <aside class="grid gap-6 content-start lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:sticky lg:top-24">
        {% set zoomHeadingLevel = 3 %}{% include "partials/zoom-card.njk" %}
        {% if L.accessibilityNote %}
        <div class="panel-muted text-sm">
          {% if L.accessibilityHeading %}<h3 class="h-card">{{ L.accessibilityHeading | tokens }}</h3>{% endif %}
          <div class="prose text-muted mt-2">{{ L.accessibilityNote | tokens | md | mailSubject(t.contact.subjectAccessibility | tokens) | safe }}</div>
          {% if t.join.accessibilityLink %}<a href="/accessibility/#espanol" class="tap-link mt-2" hreflang="en">{{ t.join.accessibilityLink | tokens }} {% icon "arrow-right", "icon" %}</a>{% endif %}
        </div>
        {% endif %}
      </aside>
      <div class="lg:col-start-1 lg:row-start-2">
        {% set joinPart = "more" %}{% include "partials/join-steps.njk" %}
      </div>
    </div>
  </div>
</section>

{# ============ VOLANTE ============ #}
<section class="section section-band" id="volante">
  <div class="container-page">
    <div class="grid gap-8 flyer-band">
      <div class="flyer-band-head">
        {{ ui.sectionHead(t.flyer.heading | tokens, t.flyer.lead | tokens) }}
      </div>
      <div class="flyer-band-img">
        {% set flyerSizes = "(min-width: 1024px) 24rem, 20rem" %}{% set flyerLoading = "lazy" %}{% set flyerHref = "/es/flyer/" %}{% set flyerDescribedBy = "" %}
        {% include "partials/flyer-picture.njk" %}
      </div>
      <div class="flyer-band-body">
        {% if t.flyer.englishOnly %}<p class="panel-muted text-sm mb-4">{% icon "info", "icon" %} {{ t.flyer.englishOnly | tokens }}</p>{% endif %}
        {# The Spanish poster (view + downloads) is one labelled group inside flyer-downloads.njk. #}
        {% set flyerShowView = true %}{% include "partials/flyer-downloads.njk" %}
      </div>
    </div>
  </div>
</section>

{# ============ PREGUNTAS ============ #}
<section class="section" id="preguntas">
  <div class="container-page">
    <div class="section-head">
      <h2 class="h-section">{{ L.faqHeading | tokens }}</h2>
      {% if L.faqLead %}<div class="lead prose">{{ L.faqLead | tokens | mdInline | mailSubject(t.contact.subject | tokens) | safe }}</div>{% endif %}
    </div>
    <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <div class="lg:order-2 lg:sticky lg:top-24">
        {% set qHeadingLevel = 3 %}{% set qSubject = "" %}{% set qId = "" %}{% include "partials/questions-card.njk" %}
      </div>
      <div class="faq" id="faq">
        {% set esFaq = [] %}{% for q in faq.items %}{% if q.qEs and q.aEs %}{% set _ = esFaq.push(q) %}{% endif %}{% endfor %}
        {% for q in esFaq %}
        <details{% if loop.first %} open{% endif %}{% if q.id %} id="faq-{{ q.id }}"{% endif %}>
          <summary>{{ q.qEs | tokens }}</summary>
          <div class="answer prose">{{ q.aEs | tokens | md | mailSubject(t.contact.subject | tokens) | safe }}</div>
        </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# ============ SÉPTIMA TRADICIÓN · ANONIMATO · COMPARTIR ============ #}
<section class="section section-band" id="septima">
  <div class="container-page">
    <div class="grid-cards">
      <article class="card">
        <h2 class="h-card">{% icon "heart-handshake", "icon" %} {{ L.seventhHeading | tokens }}</h2>
        {% set seventhHtml = L.seventh | tokens | md %}
        <div class="prose text-muted mt-2">{{ seventhHtml | mailSubject(t.contact.subjectContribution | tokens) | safe }}</div>
        {% if site.contact.email and not (site.contact.email in seventhHtml) %}<a href="{{ site.contact.email | mailto(t.contact.subjectContribution | tokens) }}" class="tap-link mt-3 email-link">{% icon "mail", "icon" %}<span>{{ t.contact.linkText | tokens }}</span></a>{% endif %}
      </article>
      <article class="card">
        <h2 class="h-card">{% icon "users", "icon" %} {{ L.anonymityHeading | tokens }}</h2>
        <div class="prose text-muted mt-2">{{ L.anonymity | tokens | md | safe }}</div>
      </article>
      <article class="card" id="compartir">
        <h2 class="h-card">{% icon "share-2", "icon" %} {{ (L.shareHeading | tokens) or t.labels.share }}</h2>
        <div class="mt-3">{% set sharePath = "" %}{% include "partials/share.njk" %}</div>
      </article>
    </div>
  </div>
</section>

{# ============ LEGADOS + 36 ============ #}
<section class="section" id="legados">
  <div class="container-page">
    <h2 class="h-section">{{ t.legacies.steps }} · {{ t.legacies.traditions }} · {{ t.legacies.concepts }}</h2>
    {% if L.intro and L.intro.length %}<div class="prose text-lg mt-4 mb-8">{% for p in L.intro %}{{ p | tokens | md | safe }}{% endfor %}</div>{% endif %}
    {% if L.legaciesLead %}<p class="lead mt-6">{{ L.legaciesLead | tokens }}</p>{% endif %}
    <div class="grid-cards mt-6">{% for l in site.legacies %}{{ ui.legacyCard(l, "es", t) }}{% endfor %}</div>
    {% if L.hook %}<p class="eyebrow mt-12">{{ L.hook | tokens }}</p>{% endif %}
    <h2 class="h-section{{ ' mt-2' if L.hook else ' mt-12' }}">{{ L.thirtySixHeading | tokens }}</h2>
    <div class="prose mt-3">{{ L.thirtySix | tokens | md | safe }}</div>
    {% if L.principlesNote or L.principlesLink %}<p class="panel-muted mt-4 text-sm">{{ L.principlesNote | tokens }} <a href="/principles/" class="underline" hreflang="en">{{ (L.principlesLink | tokens) or t.nav.principles }}</a></p>{% endif %}
  </div>
</section>
