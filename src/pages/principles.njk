---
permalink: /principles/
title: The 36 principles
description: "All 36 principles of A.A. side by side: the Twelve Steps, Twelve Traditions and Twelve Concepts for World Service, with the thread that runs through each number."
---
{% import "macros/ui.njk" as ui %}
<section class="section weave-bg">
  <div class="container-page hero" style="padding-block: clamp(2rem, 5vw, 4rem)">
    <p class="eyebrow">{{ site.hook }}</p>
    <h1 class="h-display">{{ copy.thirtySix.heading | tokens }}</h1>
    <p class="lead">{{ copy.thirtySix.lead | tokens }}</p>
    {# Only the first paragraph: the second one introduces (and links to) this very page. #}
    <div class="prose mt-6">{{ copy.thirtySix.body[0] | tokens | md | safe }}</div>
  </div>
</section>

<section class="section-tight">
  <div class="container-page">
    <div class="grid-cards">
      {% for l in site.legacies %}
      <article class="card legacy-card" id="{{ l.key }}" style="--legacy: var(--c-{{ l.key }}); --legacy-soft: var(--c-{{ l.key }}-soft); --legacy-text: var(--c-{{ l.key }}-text)">
        <div class="legacy-card-stripe" aria-hidden="true"></div>
        <p class="eyebrow legacy-eyebrow">{{ l.name }}</p>
        <h2 class="h-card">{{ l.body }}</h2>
        <p class="text-muted mt-1">{{ l.blurb }}</p>
        <p class="text-xs text-muted mt-2">{{ l.source }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" x-data="{ view: 'all' }">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
      <div>
        <h2 class="h-section">Side by side</h2>
        {#- Until the official texts are pasted into principles.json (text), the number pages give a gist and a link to aa.org. -#}
        {% set textsShown = [] %}{% for p in principles.items %}{% if p.step.text or p.tradition.text or p.concept.text %}{% set _ = textsShown.push(p.n) %}{% endif %}{% endfor %}
        <p class="text-muted mt-1">{% if textsShown.length %}Choose a number for the texts{% else %}Choose a number for a summary of each Step, Tradition and Concept with a link to its text at aa.org{% endif %}, the thread that connects them, and questions for a meeting or a sponsor conversation.</p>
      </div>
      <div class="chip-row" role="group" aria-label="Show">
        <button type="button" class="chip" :aria-pressed="(view === 'all').toString()" aria-pressed="true" @click="view = 'all'">All three</button>
        {% for l in site.legacies %}
        <button type="button" class="chip" :aria-pressed="(view === '{{ l.key }}').toString()" aria-pressed="false" @click="view = '{{ l.key }}'"><span class="legacy-dot" style="display:inline-block;width:.6rem;height:.6rem;border-radius:50%;background:{{ l.color }}"></span>{{ l.shortBody }}</button>
        {% endfor %}
      </div>
    </div>

    <table class="principles-table" :class="view === 'all' ? '' : 'show-' + view">
      <thead>
        <tr>
          <th scope="col">#</th>
          {% for l in site.legacies %}<th scope="col" class="{{ l.key }}" style="--legacy: var(--c-{{ l.key }}); --legacy-text: var(--c-{{ l.key }}-text)"><span class="legacy-dot"></span>{{ l.singular }}</th>{% endfor %}
          <th scope="col">Thread</th>
        </tr>
      </thead>
      <tbody>
        {% for item in principles.items %}
        <tr>
          <td class="n"><a href="/principles/{{ item.n }}/">{{ item.n }}<small>{{ item.n | roman }}</small></a></td>
          {% for key in ["step", "tradition", "concept"] %}{% set l = site.legacies[loop.index0] %}
          <td class="{{ l.key }}" data-label="{{ l.singular }} {{ item.n }}" style="--legacy: var(--c-{{ l.key }}); --legacy-text: var(--c-{{ l.key }}-text)"><span class="word">{{ item[key].principle }}</span>{% if item[key].text %}{{ item[key].text }}{% else %}{{ item[key].gist }} <a href="{{ principles.sources[key].url }}" class="text-muted text-xs whitespace-nowrap" target="_blank" rel="noopener">{{ 'Read ' + l.singular + ' ' + (item.n | roman if key == 'concept' else item.n) }} ↗<span class="sr-only"> {{ t.a11y.openInNewTab }}</span></a>{% endif %}</td>
          {% endfor %}
          <td class="thread" data-label="Thread"><a href="/principles/{{ item.n }}/">{{ item.thread.title }}</a><p class="text-muted text-sm mt-1">{{ item.thread.oneLiner }}</p></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <p class="text-sm text-muted mt-6 max-w-3xl">{{ principles.principleWordsNote }}</p>
    <p class="text-xs text-muted mt-2 max-w-3xl">{{ principles.notice }}</p>
  </div>
</section>

{# The weekly meeting card and its format: only once meeting.json is published. #}
{% if meeting.published %}
<section class="section section-band">
  <div class="container-page">
    <div class="grid gap-6 lg:grid-cols-2">
      <div class="card">
        <h2 class="h-card">{{ copy.meetingTeaser.heading | tokens }}</h2>
        <p class="text-muted mt-2">{{ copy.meetingTeaser.body | tokens }}</p>
        <a href="/meeting/" class="btn btn-primary mt-4">{{ copy.meetingTeaser.cta | tokens }}</a>
      </div>
      <div class="card">
        <h2 class="h-card">Suggested meeting format</h2>
        <ol class="prose mt-2 text-muted list-decimal pl-5">{% for f in meeting.format %}<li>{{ f }}</li>{% endfor %}</ol>
      </div>
    </div>
  </div>
</section>
{% endif %}
