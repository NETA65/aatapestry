---
permalink: /accessibility/
title: Accessibility & interpretation
description: "Spanish and ASL interpretation for The Incredible Tapestry online A.A. workshop: how to choose them in Zoom, other help, and where to send questions."
---
{#- Sections come from copy.accessibility.sections, each with a key ("es", "asl", "captions", "other");
    icons and the interpretation labels from site.json are looked up by that key, never by position
    (the "es" card adds its Spanish name, marked lang="es", from site.json → labelEs).
    The section bodies carry the how-to, so the short site.json notes are not repeated here. The questions
    address is printed once, in the requests panel. The Spanish card (#espanol) repeats /es/'s
    interpretation how-to and accessibility note for Spanish readers sent here from /es/. -#}
{% import "macros/ui.njk" as ui %}
{% set icons = { "es": "languages", "asl": "hand", "captions": "captions", "other": "accessibility" } %}
<section class="section weave-bg">
  <div class="container-page hero" style="padding-block: clamp(2rem, 5vw, 4rem)">
    <p class="eyebrow">{{ when.date.long }} · <span class="normal-case">{{ when.time.lead }}</span> · {{ t.labels.online | tokens }}</p>
    <h1 class="h-display">{{ copy.accessibility.heading | tokens }}</h1>
    <p class="lead">{{ copy.accessibility.lead | tokens }}</p>
    <div class="hero-badges">
      {% for key in ["es", "asl"] %}{% set i = site.event.interpretation | byKey(key) %}{% if i %}{% set iconName = icons[key] %}<span class="badge">{% icon iconName, "icon" %}{{ i.label }}</span>{% endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div class="grid gap-8">
        {% for s in copy.accessibility.sections %}
        <article class="card" id="{{ s.key or (s.title | slugify) }}">
          {% set iconName = icons[s.key] or "info" %}
          {% set interp = (site.event.interpretation | byKey("es")) if s.key == "es" else "" %}
          <h2 class="h-card">{% icon iconName, "icon" %} {{ s.title | tokens }}{% if interp and interp.labelEs %} <span lang="es">({{ interp.labelEs }})</span>{% endif %}</h2>
          <div class="prose text-muted mt-3">{% for p in s.body %}{{ p | tokens | md | mailSubject(t.contact.subjectAccessibility | tokens) | safe }}{% endfor %}</div>
        </article>
        {% endfor %}
        <div class="panel-muted">
          <p class="font-semibold">{{ copy.accessibility.requests | tokens }}</p>
          {% if site.contact.email %}<a href="{{ site.contact.email | mailto(t.contact.subjectAccessibility | tokens) }}" class="tap-link mt-2 email-link">{% icon "mail", "icon" %}<span>{{ site.contact.email }}</span></a>{% endif %}
        </div>
        <article class="card" id="etiquette">
          <h2 class="h-card">{{ t.join.etiquetteHeading | tokens }}</h2>
          <ul class="prose text-muted mt-3 list-disc pl-5">{% for e in t.join.etiquette %}<li>{{ e | tokens | mdInline | safe }}</li>{% endfor %}</ul>
        </article>
        {% set esJoin = i18n.es.join if (i18n.es and i18n.es.join) else {} %}
        <article class="card" id="espanol" lang="es">
          <h2 class="h-card">{% icon "languages", "icon" %} {{ (esJoin.interpretationHeading | tokens) or i18n.es.langName }}</h2>
          <div class="prose text-muted mt-3">
            {% for key in ["es", "asl"] %}{% for p in (esJoin.interpretation[key] if esJoin.interpretation else []) %}{{ p | tokens | md | safe }}{% endfor %}{% endfor %}
            {% if i18n.es.landing and i18n.es.landing.accessibilityNote %}{{ i18n.es.landing.accessibilityNote | tokens | md | mailSubject(i18n.es.contact.subjectAccessibility | tokens) | safe }}{% endif %}
          </div>
          <a href="/es/#interpretacion" class="tap-link mt-3" hreflang="es">{{ (i18n.es.labels.backHome | tokens) or i18n.en.switchLabel }} {% icon "arrow-right", "icon" %}</a>
        </article>
      </div>
      <aside class="grid gap-6 content-start">
        {% set zoomHeadingLevel = 2 %}{% include "partials/zoom-card.njk" %}
        <div class="card">
          <h2 class="h-card">{{ copy.anonymity.heading | tokens }}</h2>
          <div class="prose text-muted mt-2">{% for p in copy.anonymity.body %}{{ p | tokens | md | safe }}{% endfor %}</div>
        </div>
      </aside>
    </div>
  </div>
</section>
