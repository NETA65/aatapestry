{
  "name": "aatapestry",
  "version": "1.0.0",
  "description": "The Incredible Tapestry — an A.A. workshop weaving the Steps, Traditions and Concepts together (aatapestry.org)",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:html && npm run test:links",
    "start": "eleventy --serve",
    "dev": "eleventy --serve",
    "build": "npm run brand:mark && npm run build:brand && npm run brand:site && eleventy",
    "build:site": "eleventy",
    "build:brand": "node scripts/build-brand.mjs",
    "pdf": "node scripts/pdf.mjs",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "test:html": "html-validate \"_site/**/*.html\"",
    "test:links": "linkinator _site --recurse --skip \"^https?://(?!localhost|127\\.0\\.0\\.1)\" --verbosity error",
    "zoom:update": "node scripts/update-zoom.mjs",
    "zoom:sync": "node scripts/sync-zoom.mjs",
    "brand:mark": "node scripts/make-aa-mark.mjs",
    "brand:site": "node scripts/make-site-logo.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": "true",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.3.3",
    "axe-core": "^4.14.0",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "^11.4.0",
    "ics": "^3.12.1",
    "linkinator": "^8.1.0",
    "lucide-static": "^1.52.0",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.2",
    "opentype.js": "^2.0.0",
    "pdfkit": "^0.20.2",
    "png-to-ico": "^3.0.2",
    "puppeteer": "^25.12.0",
    "qrcode": "^1.5.4",
    "svg-to-pdfkit": "^0.1.8",
    "tailwindcss": "^4.3.3",
    "wawoff2": "^2.0.1"
  }
}
